---
import type { Project } from '../data/site';

interface Props {
  project: Project;
  /** First cards render eagerly; the rest lazy-load. */
  priority?: boolean;
  /**
   * `wide` runs the same card horizontally at desktop width. It is a layout
   * change only: the category, title, description, note and CTA all come from
   * the same record, so a project can lead the page without different copy or
   * a badge announcing that it leads.
   */
  layout?: 'compact' | 'wide';
}

const { project, priority = false, layout = 'compact' } = Astro.props;
const headingId = `project-${project.slug}`;
const mediaCta =
  project.cta && (project.linkCover || project.linkCard || !project.cta.external) ? project.cta : null;
const actions = [project.cta, project.secondaryCta].filter(
  (action): action is NonNullable<Project['cta']> =>
    action != null && !(project.coverLabel && action === project.cta),
);
---

<article
  class:list={['card', layout === 'wide' && 'card--wide']}
  id={`card-${project.slug}`}
  tabindex="-1"
  aria-labelledby={headingId}
>
  <div class="card__media">
    {
      project.comingSoonMedia ? (
        <div class="card__soon" aria-hidden="true">
          <span class="card__soon-label">Coming soon</span>
        </div>
      ) : mediaCta ? (
        <a
          class:list={[
            'card__media-link',
            project.linkCard && 'card__media-link--card',
            project.coverLabel && 'card__media-link--labeled',
          ]}
          href={mediaCta.href}
          aria-label={mediaCta.external ? `${mediaCta.label} (opens in a new tab)` : mediaCta.label}
          {...(mediaCta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <img
            src={project.image}
            alt=""
            width="1280"
            height="800"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding="async"
          />
          {
            project.coverLabel && (
              <span class="card__cover-label">
                {mediaCta.label}
                <span aria-hidden="true">↗</span>
              </span>
            )
          }
          {mediaCta.external && <span class="visually-hidden">(opens in a new tab)</span>}
        </a>
      ) : (
        <img
          src={project.image}
          alt={project.imageAlt}
          width="1280"
          height="800"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
        />
      )
    }
  </div>

  <div class="card__body">
    <div class="card__copy">
      <p class="card__category">{project.category}</p>
      <h3 class="card__title" id={headingId}>{project.title}</h3>
      <p class="card__description">{project.description}</p>
    </div>

    {/* Quiet context: what Frances built, and what the visual actually is.
        The wording belongs to each project in src/data/site.ts, so nothing
        here is conditional on which project is being rendered. */}
    {project.portfolioNote && <p class="card__note">{project.portfolioNote}</p>}

    {
      actions.length > 0 && (
        <p class="card__cta">
          {actions.map((action) => (
            <a
              class="text-link"
              href={action.href}
              {...(action.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {action.label}
              <span aria-hidden="true">↗</span>
              {action.external && <span class="visually-hidden">(opens in a new tab)</span>}
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  /*
    Compact supporting work is editorial, not a tile. No full card chrome —
    media carries the crop, type sits in open space. That keeps a three-up row
    from reading as a dashboard and from outgrowing the lead by vertical mass.
  */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: transparent;
  }

  .card__media {
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #05070a;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .card__media-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card__media-link--labeled {
    position: relative;
  }

  /* Same type as a text link, set on the cover. The fade keeps it readable
     on a light product screenshot without covering the top of the interface. */
  .card__cover-label {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 1.35rem 0.9rem 0.65rem;
    background: linear-gradient(to top, rgba(8, 10, 14, 0.82), rgba(8, 10, 14, 0));
    color: var(--cobalt-bright);
    font-weight: 550;
    font-size: var(--step-small);
    line-height: 1;
    pointer-events: none;
  }

  .card__media-link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -3px;
  }

  /* Primary destination covers the card. Labeled actions sit above it. */
  .card__media-link--card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Quiet Coming Soon surface. Recedes behind real work; never a badge or
     empty-state component. Decorative — titles/descriptions carry meaning. */
  .card__soon {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(
        70% 65% at 50% 42%,
        rgba(22, 34, 52, 0.38) 0%,
        rgba(12, 16, 24, 0.12) 48%,
        rgba(10, 12, 18, 0) 72%
      ),
      #0c1017;
  }

  .card__soon-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    opacity: 0.52;
    line-height: 1;
    /* Optical lift — default grid center sits a hair low against the glow. */
    transform: translateY(-0.05em);
  }

  @media (max-width: 767.98px) {
    .card__soon-label {
      font-size: 0.6875rem;
      letter-spacing: 0.15em;
      opacity: 0.5;
    }
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.95rem 0.1rem 0;
  }

  .card__copy {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .card__category {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--text-tertiary);
  }

  .card__title {
    font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.3125rem);
    line-height: 1.25;
  }

  .card__description {
    font-size: var(--step-small);
    line-height: 1.52;
    color: var(--text-secondary);
  }

  /* Secondary to the story. Kept readable, never a legal callout. */
  .card__note {
    padding-top: 0.35rem;
    font-size: 0.6875rem;
    line-height: 1.45;
    color: var(--text-tertiary);
    border-top: 1px solid rgba(242, 239, 233, 0.05);
    margin-top: 0.15rem;
  }

  .card__cta {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 1.15rem;
    margin-top: 0.15rem;
  }

  .card__cta .text-link {
    min-height: 44px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .card__cta .text-link {
      min-height: 0;
      padding-block: 0.2rem;
    }
  }

  /* Wide: the one framed surface. Below this width it stays stacked so a lead
     project is never a tall phone block. Media stays 16/9 so the row lands
     around 360–420px instead of a second hero. */
  @media (min-width: 1024px) {
    .card--wide {
      flex-direction: row;
      align-items: stretch;
      overflow: hidden;
      border: 1px solid rgba(242, 239, 233, 0.08);
      border-radius: var(--radius-lg);
      background: linear-gradient(90deg, #0d1016 0%, var(--bg-raised) 58%);
    }

    .card--wide .card__media {
      flex: 0 0 58%;
      aspect-ratio: 16 / 9;
      border-radius: 0;
      border-right: 1px solid rgba(242, 239, 233, 0.05);
    }

    /* Compact crops from the top (product chrome). The lead is a shallower
       centred crop, so it holds the middle of the composition. */
    .card--wide .card__media img {
      object-position: center;
    }

    .card--wide .card__body {
      flex: 1 1 42%;
      justify-content: center;
      gap: 0.75rem;
      padding: clamp(1.5rem, 0.8rem + 1.8vw, 2.35rem) clamp(1.5rem, 0.9rem + 1.6vw, 2.4rem);
    }

    .card--wide .card__copy {
      gap: 0.75rem;
    }

    /* Hierarchy from width and title scale, not a label. */
    .card--wide .card__title {
      font-size: clamp(1.5rem, 1.15rem + 1.1vw, 1.9rem);
    }

    .card--wide .card__category {
      font-size: 0.8125rem;
    }

    .card--wide .card__description {
      color: var(--text);
      line-height: 1.58;
    }

    .card--wide .card__note {
      font-size: 0.8125rem;
      line-height: 1.5;
    }
  }

  @media (min-width: 1280px) {
    .card--wide .card__media {
      flex: 0 0 60%;
    }

    .card--wide .card__body {
      flex: 1 1 40%;
    }
  }

  /* On small screens the supporting set stacks, so restore a light surface
     so each project still reads as a discrete unit while scrolling. */
  @media (max-width: 767.98px) {
    .card:not(.card--wide) {
      border: 1px solid rgba(242, 239, 233, 0.06);
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: var(--bg-raised);
    }

    .card:not(.card--wide) .card__media {
      aspect-ratio: 16 / 9;
      border-radius: 0;
    }

    .card:not(.card--wide) .card__body {
      gap: 0.5rem;
      padding: 1.1rem 1.15rem 1.25rem;
    }

    .card:not(.card--wide) .card__copy {
      gap: 0.5rem;
    }
  }
</style>
