---
import type { Project } from '../data/site';
import ItemGlow from './ItemGlow.astro';

interface Props {
  project: Project;
  /** First cards render eagerly; the rest lazy-load. */
  priority?: boolean;
  /**
   * `wide` runs the same card horizontally at desktop width. It is a layout
   * change only: the category, title, description, note and CTA all come from
   * the same record, so a project can lead the page without different copy or
   * a badge announcing that it leads.
   */
  layout?: 'compact' | 'wide';
}

const { project, priority = false, layout = 'compact' } = Astro.props;
const headingId = `project-${project.slug}`;
const imageSrcset = project.imageSmall
  ? `${project.imageSmall} 960w, ${project.image} 1920w`
  : undefined;
const imageSizes =
  layout === 'wide'
    ? '(min-width: 1280px) 46rem, (min-width: 1024px) 58vw, (min-width: 768px) 50vw, 100vw'
    : '(min-width: 1264px) 24rem, (min-width: 1024px) 30vw, (min-width: 768px) 50vw, 100vw';
const primary = project.cta;
const actions = [project.cta, project.secondaryCta].filter(
  (action): action is NonNullable<Project['cta']> => action != null,
);
const newTab = (action: NonNullable<Project['cta']>) =>
  action.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<article
  class:list={['card', 'item-glow-host', layout === 'wide' && 'card--wide']}
  id={`card-${project.slug}`}
  tabindex="-1"
  aria-labelledby={headingId}
>
  <ItemGlow />
  <div class:list={['card__media', layout !== 'wide' && 'item-zoom item-zoom--tight']}>
    {
      project.comingSoonMedia ? (
        <div class="card__soon" aria-hidden="true">
          <span class="card__soon-label">Coming soon</span>
        </div>
      ) : primary ? (
        /* The same destination as the title link, so it stays out of the tab
           order and the accessibility tree: one stop per destination. On a
           fine pointer, hovering it shows the larger preview. */
        <a
          class="card__shot"
          href={primary.href}
          tabindex="-1"
          aria-hidden="true"
          data-shot={project.preview ? project.slug : undefined}
          {...newTab(primary)}
        >
          <img
            src={project.image}
            srcset={imageSrcset}
            sizes={imageSizes}
            alt=""
            width="1920"
            height="1080"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding="async"
          />
        </a>
      ) : (
        <img
          src={project.image}
          srcset={imageSrcset}
          sizes={imageSizes}
          alt={project.imageAlt}
          width="1920"
          height="1080"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
        />
      )
    }
    {
      project.preview && (
        /* Sibling of the screenshot link, never inside it. Icon only: the
           name lives in the accessible label. */
        <button
          type="button"
          class="card__expand"
          data-preview-trigger={project.slug}
          aria-haspopup="dialog"
          aria-label={`Expand image: ${project.title}`}
        >
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9" />
          </svg>
        </button>
      )
    }
  </div>

  <div class="card__body">
    <div class="card__copy">
      <p class="card__category">{project.category}</p>
      <h3 class="card__title" id={headingId}>
        {
          primary ? (
            <a href={primary.href} {...newTab(primary)}>
              {project.title}
              {primary.external && <span class="visually-hidden">(opens in a new tab)</span>}
            </a>
          ) : (
            project.title
          )
        }
      </h3>
      <p class="card__description">{project.description}</p>
    </div>

    {/* Quiet context: what Frances built, and what the visual actually is.
        The wording belongs to each project in src/data/site.ts, so nothing
        here is conditional on which project is being rendered. */}
    {project.portfolioNote && <p class="card__note">{project.portfolioNote}</p>}

    {
      actions.length > 0 && (
        <p class="card__cta">
          {actions.map((action) => {
            const kind = action.label === 'Prototype' ? 'interactive prototype' : action.label.toLowerCase();
            const name = `${project.title} ${kind}`;
            return (
              <a
                class="text-link"
                href={action.href}
                aria-label={action.external ? `${name} (opens in a new tab)` : name}
                {...newTab(action)}
              >
                {action.label}
                <span class:list={['arrow', action.external && 'arrow--out']} aria-hidden="true">
                  {action.external ? '↗' : '→'}
                </span>
              </a>
            );
          })}
        </p>
      )
    }
  </div>
</article>

<style>
  /*
    Compact supporting work is editorial, not a tile. No full card chrome —
    media carries the crop, type sits in open space. That keeps a three-up row
    from reading as a dashboard and from outgrowing the lead by vertical mass.
  */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: transparent;
  }

  .card__media,
  .card__body {
    position: relative;
    z-index: 1;
  }

  .card__media {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: #05070a;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* ---------- Screenshot ---------- */

  .card__shot {
    position: relative;
    display: block;
    height: 100%;
    border-radius: inherit;
    color: inherit;
  }

  /* The surface edge: a hairline that brightens on hover. The larger preview
     is the response; the image itself stays still. */
  .card__shot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(242, 239, 233, 0.06);
    transition: box-shadow 200ms var(--ease);
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .card__shot:hover::after {
      box-shadow: inset 0 0 0 1px rgba(242, 239, 233, 0.22);
    }
  }

  /* While the expanded image is open it stands in for this one. */
  .card__shot[data-preview-source] img {
    visibility: hidden;
  }

  /* Icon only, in the corner of the image. On a fine pointer it appears with
     the screenshot hover or with keyboard focus, so it never takes a text row.
     Touch has no hover, so the control is simply there. */
  .card__expand {
    position: absolute;
    z-index: 2;
    top: 0.55rem;
    right: 0.55rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: rgba(11, 13, 18, 0.78);
    box-shadow: inset 0 0 0 1px rgba(242, 239, 233, 0.16);
    color: var(--text);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 160ms var(--ease),
      background-color 160ms var(--ease);
  }

  .card__expand:hover {
    background: rgba(11, 13, 18, 0.92);
  }

  .card__expand:focus-visible {
    opacity: 1;
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .card__media:hover .card__expand {
      opacity: 1;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .card__expand {
      top: 0.4rem;
      right: 0.4rem;
      width: 2.75rem;
      height: 2.75rem;
      opacity: 1;
    }
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card__title a:hover,
  .card__title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--border-strong);
  }

  /* ---------- Entrance ---------- */

  /* Set by script only for cards still below the fold, so without it, or
     before it runs, every card is simply visible. Plays once, and briefly. */
  .card[data-reveal] .card__media,
  .card[data-reveal] .card__body {
    transition:
      opacity 420ms var(--ease),
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .card[data-reveal='pending'] .card__media,
  .card[data-reveal='pending'] .card__body {
    opacity: 0;
    transform: translate3d(0, 12px, 0);
  }

  /* Quiet Coming Soon surface. Recedes behind real work; never a badge or
     empty-state component. Decorative — titles/descriptions carry meaning. */
  .card__soon {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(
        70% 65% at 50% 42%,
        rgba(22, 34, 52, 0.38) 0%,
        rgba(12, 16, 24, 0.12) 48%,
        rgba(10, 12, 18, 0) 72%
      ),
      #0c1017;
  }

  .card__soon-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    opacity: 0.52;
    line-height: 1;
    /* Optical lift — default grid center sits a hair low against the glow. */
    transform: translateY(-0.05em);
  }

  @media (max-width: 767.98px) {
    .card__soon-label {
      font-size: 0.6875rem;
      letter-spacing: 0.15em;
      opacity: 0.5;
    }
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.95rem 0.1rem 0;
  }

  .card__copy {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .card__category {
    font-size: 14px;
    line-height: 20px;
    letter-spacing: normal;
    color: var(--text-tertiary);
  }

  .card__title {
    font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.3125rem);
    line-height: 1.25;
  }

  .card__description {
    font-size: var(--step-small);
    line-height: 1.52;
    color: var(--text-secondary);
  }

  /* A role line, secondary to the description and readable on its own. */
  .card__note {
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .card__cta {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 1.15rem;
    margin-top: 0.15rem;
  }

  .card__cta .text-link {
    min-height: 44px;
    align-items: center;
  }

  .card__cta .text-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (min-width: 1024px) {
    .card__cta .text-link {
      min-height: 0;
      padding-block: 0.2rem;
    }
  }

  /* Wide: the one framed surface. Below this width it stays stacked so a lead
     project is never a tall phone block. Media stays 16/9 so the row lands
     around 360–420px instead of a second hero. */
  @media (min-width: 1024px) {
    .card--wide {
      flex-direction: row;
      align-items: stretch;
      overflow: hidden;
      border: 1px solid rgba(242, 239, 233, 0.08);
      border-radius: 8px;
      background: linear-gradient(90deg, #0d1016 0%, var(--bg-raised) 58%);
    }

    .card--wide .card__media {
      flex: 0 0 58%;
      aspect-ratio: 16 / 9;
      border-radius: 0;
      border-right: 1px solid rgba(242, 239, 233, 0.05);
    }

    /* Compact crops from the top (product chrome). The lead is a shallower
       centred crop, so it holds the middle of the composition. */
    .card--wide .card__media img {
      object-position: center;
    }

    .card--wide .card__body {
      flex: 1 1 42%;
      justify-content: center;
      gap: 0.75rem;
      padding: clamp(1.5rem, 0.8rem + 1.8vw, 2.35rem) clamp(1.5rem, 0.9rem + 1.6vw, 2.4rem);
    }

    .card--wide .card__copy {
      gap: 0.75rem;
    }

    /* Hierarchy from width and title scale, not a label. */
    .card--wide .card__title {
      font-size: clamp(1.5rem, 1.15rem + 1.1vw, 1.9rem);
    }

    .card--wide .card__description {
      color: var(--text);
      line-height: 1.58;
    }

    .card--wide .card__note {
      font-size: 0.8125rem;
      line-height: 1.5;
    }
  }

  @media (min-width: 1280px) {
    .card--wide .card__media {
      flex: 0 0 60%;
    }

    .card--wide .card__body {
      flex: 1 1 40%;
    }
  }

  /* Tablet: one project per line, image beside its copy, so no project is
     left alone on a row and no column becomes a narrow shaft of text. */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .card {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      align-items: center;
      gap: 1.75rem;
    }

    .card__media {
      aspect-ratio: 16 / 10;
    }

    .card__body {
      padding: 0;
    }
  }

  /* On small screens the supporting set stacks, so restore a light surface
     so each project still reads as a discrete unit while scrolling. */
  @media (max-width: 767.98px) {
    .card:not(.card--wide) {
      border: 1px solid rgba(242, 239, 233, 0.06);
      border-radius: 8px;
      overflow: hidden;
      background: var(--bg-raised);
    }

    .card:not(.card--wide) .card__media {
      aspect-ratio: 16 / 9;
      border-radius: 0;
    }

    .card:not(.card--wide) .card__body {
      gap: 0.5rem;
      padding: 1.1rem 1.15rem 1.25rem;
    }

    .card:not(.card--wide) .card__copy {
      gap: 0.5rem;
    }
  }
</style>
