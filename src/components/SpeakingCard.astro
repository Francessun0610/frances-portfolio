---
import type { Talk } from '../data/site';
import ItemGlow from './ItemGlow.astro';

interface Props {
  talk: Talk;
  priority?: boolean;
  /** Must sit one level below the surrounding section heading. */
  headingLevel?: 2 | 3;
}

const { talk, priority = false, headingLevel = 3 } = Astro.props;
/* Speaker cards and posters carry type out to the edge, so a zoom would crop it. */
const graphic = /card|poster/i.test(talk.imageAlt);
const zoom = talk.imageFit !== 'contain' && !graphic;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const headingId = `talk-${talk.slug}`;
---

<article class="talk-card item-glow-host" aria-labelledby={headingId}>
  <ItemGlow />
  <a class="talk-card__link" href={`/speaking/${talk.slug}`}>
    <span class="visually-hidden">View talk: {talk.title}</span>
  </a>

  <div
    class:list={[
      'talk-card__media',
      zoom && 'item-zoom',
      talk.imageFit === 'contain' && 'talk-card__media--contain',
    ]}
  >
    <img
      src={talk.image}
      alt={talk.imageAlt}
      width={talk.imageWidth ?? 1600}
      height={talk.imageHeight ?? 1000}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>

  <div class="talk-card__body">
    <p class="talk-card__event">
      <span class="talk-card__event-name">{talk.event}</span>
      {
        /* The host organisation already identifies the place, so the separate
           location line is only shown when there is no organisation. */
        talk.organization?.length ? (
          <span class="talk-card__org">
            {talk.organization.map((line, index) => (
              <>
                {index > 0 && ' · '}
                <span class="talk-card__org-part">{line}</span>
              </>
            ))}
          </span>
        ) : (
          <span class="talk-card__location">
            {talk.venue ? `${talk.venue} · ${talk.location}` : talk.location}
          </span>
        )
      }
    </p>

    <Heading class="talk-card__title" id={headingId}>{talk.title}</Heading>
    <p class="talk-card__description">{talk.cardDescription}</p>

    <p class="talk-card__cta" aria-hidden="true">
      View talk <span>→</span>
    </p>
  </div>
</article>

<style>
  .talk-card {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Quieter than Selected Work's lead surface — speaking is secondary. */
    border: 1px solid rgba(242, 239, 233, 0.06);
    border-radius: 8px;
    background: var(--bg-raised);
    transition: border-color 200ms var(--ease);
  }

  /* Whole-card target, without nesting interactive elements. */
  .talk-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .talk-card:hover {
    border-color: rgba(242, 239, 233, 0.12);
  }

  .talk-card:focus-within {
    border-color: var(--cobalt);
  }

  .talk-card__link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
    border-radius: 8px;
  }

  .talk-card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px 8px 0 0;
    background: #05070a;
    border-bottom: 1px solid rgba(242, 239, 233, 0.05);
  }

  .talk-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Portrait posters stay whole inside the same 16:9 frame. */
  .talk-card__media--contain img {
    object-fit: contain;
  }

  .talk-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.5rem);
  }

  .talk-card__event {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .talk-card__event-name {
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* Keep each place name intact. The line may break between them on small screens. */
  .talk-card__org-part {
    white-space: nowrap;
  }

  /* Desktop cards fit the venue and university together, so this title stays
     level with the card beside it. */
  @media (min-width: 1024px) {
    .talk-card__org {
      white-space: nowrap;
    }
  }

  .talk-card__title {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.25;
  }

  .talk-card__description {
    font-size: var(--step-small);
    line-height: 1.62;
    color: var(--text-secondary);
  }

  .talk-card__cta {
    margin-top: 0.35rem;
    font-size: var(--step-small);
    font-weight: 550;
    color: var(--cobalt-bright);
  }

  .talk-card:hover .talk-card__cta span {
    display: inline-block;
    transform: translateX(3px);
    transition: transform 160ms var(--ease);
  }
</style>
