---
import BaseLayout from '../layouts/BaseLayout.astro';
import { person, links, PERSON_ID } from '../data/site';
import { SITE_URL } from '../config/site.mjs';

const title = 'About Frances Sun | Lead UX Designer, Educator & Speaker';
const description =
  'Frances Sun is an Austin-based Lead UX Designer, educator, and UX speaker with experience across consumer electronics, enterprise software, complex workflows, systems thinking, interaction design, and prototyping.';

// The page is about Frances, so it points at the same Person node rather than
// describing a second one.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${SITE_URL}/about#profile`,
    url: `${SITE_URL}/about`,
    name: title,
    description,
    inLanguage: 'en',
    mainEntity: { '@id': PERSON_ID },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/about"
  structuredData={structuredData}
>
  <section class="about-page">
    <div class="shell">
      <header class="about-page__head">
        <p class="eyebrow">About</p>
        <h1>{person.name}</h1>
        <p class="about-page__role">{person.role} · Educator · Speaker</p>
      </header>

      <div class="about-page__body prose">
        <p>
          I’m a Taiwanese Lead UX Designer based in Austin, Texas. I design complex products, teach
          UX, and speak about the thinking behind the work. My experience spans consumer electronics
          and enterprise software—from customer-facing experiences to operational tools.
        </p>

        <p>
          I combine hands-on design with experience leading design teams. I start by understanding
          how a process works, then shape workflows, information architecture, interactions, and
          prototypes that help teams evaluate ideas before they are built.
        </p>

        <p>
          I collaborate with product, engineering, finance, operations, and business partners.
          Alongside my design work, I teach and mentor designers, and speak at conferences and
          universities about enterprise UX, systems thinking, product clarity, and creativity.
        </p>

        <div class="about-page__aside">
          <h2 class="about-page__subhead">What I bring</h2>
          <ul class="about-page__list">
            <li>Hands-on product design</li>
            <li>Design team leadership</li>
            <li>Information architecture &amp; interaction design</li>
            <li>Interactive prototyping</li>
            <li>Systems thinking</li>
            <li>Teaching &amp; mentorship</li>
          </ul>
        </div>

        <p class="about-page__contact">
          <a class="text-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={links.instagram} target="_blank" rel="noopener noreferrer">
            Instagram <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={links.resume} target="_blank" rel="noopener noreferrer">
            Resume <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .about-page__head {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .about-page__head h1 {
    margin-bottom: 0.75rem;
  }

  .about-page__role {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--cobalt-bright);
    font-weight: 550;
  }

  .about-page__body {
    display: grid;
    gap: 1.35rem;
  }

  /* Desktop: the biography keeps a reading measure, and "What I bring"
     occupies the column that would otherwise sit empty. Same words, same order
     on small screens. */
  @media (min-width: 1100px) {
    .about-page__body {
      max-width: none;
      grid-template-columns: minmax(0, 1.55fr) minmax(14rem, 18rem);
      column-gap: clamp(3rem, 4vw, 5rem);
      row-gap: 1.15rem;
      align-items: start;
    }

    .about-page__body > p:not(.about-page__contact) {
      grid-column: 1;
      max-width: 62ch;
    }

    /* Starts with the first paragraph, not with the name. The heading and
       list stay one column so the bullets sit under the heading. */
    .about-page__aside {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: start;
      gap: 0.95rem;
    }

    .about-page__aside .about-page__subhead {
      margin-top: 0;
    }

    .about-page__contact {
      grid-column: 1 / -1;
      margin-top: 1.75rem;
    }
  }

  /* One body color across the whole page. Hierarchy comes from headings and
     spacing, never from alternating paragraph shades. */
  .about-page__body p,
  .about-page__list {
    color: #c9ced6;
  }

  .about-page__aside {
    display: grid;
    gap: 1.35rem;
  }

  .about-page__subhead {
    margin-top: 1.25rem;
    font-size: var(--step-h3);
  }

  /* Same reading size as the biography paragraphs above. The body sets
     --step-body at 1.65 line height, and the list inherits both. */
  .about-page__list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.15rem;
  }

  .about-page__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1rem;
  }
</style>
