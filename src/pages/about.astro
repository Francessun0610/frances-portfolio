---
import BaseLayout from '../layouts/BaseLayout.astro';
import { person, links, about } from '../data/site';

const title = 'About Frances Sun | Enterprise UX Designer in Austin, Texas';
const description =
  'Frances Sun is a Lead UX Designer in Austin, Texas with 18+ years designing enterprise products, operational systems, complex workflows, and design systems.';
---

<BaseLayout title={title} description={description} path="/about">
  <section class="about-page">
    <div class="shell">
      <header class="about-page__head">
        <p class="eyebrow">About</p>
        <h1>{person.name}</h1>
        <p class="about-page__role">{person.role} · {person.locality}, {person.region}</p>
      </header>

      <div class="about-page__body prose">
        <p class="lede">{about.homepage}</p>

        <p>
          My work sits where business rules, operational reality, and product design meet. That
          usually means untangling how a process actually runs before drawing a single screen:
          modelling workflows, shaping information architecture, and building interactive prototypes
          that let a team see and argue with a decision before it is built.
        </p>

        <p>
          I work end to end — discovery through implementation — alongside product, engineering,
          finance, operations, and business stakeholders. Alongside design work, I teach, mentor
          designers, and speak about enterprise UX at conferences and universities.
        </p>

        <h2 class="about-page__subhead">What I work on</h2>
        <ul class="about-page__list">
          <li>Enterprise product design and complex workflow design</li>
          <li>Information architecture and interaction design</li>
          <li>Design systems and reusable interaction patterns</li>
          <li>Interactive prototyping and implementation-ready specifications</li>
          <li>Systems thinking across connected products</li>
        </ul>

        <p class="about-page__contact">
          <a class="text-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={links.instagram} target="_blank" rel="noopener noreferrer">
            Instagram <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={links.resume} target="_blank" rel="noopener">
            Resume <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .about-page__head {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .about-page__head h1 {
    margin-bottom: 0.75rem;
  }

  .about-page__role {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--cobalt-bright);
    font-weight: 550;
  }

  .about-page__body {
    display: grid;
    gap: 1.35rem;
  }

  .about-page__body p {
    color: var(--text-secondary);
  }

  .about-page__body .lede {
    color: var(--text);
  }

  .about-page__subhead {
    margin-top: 1.25rem;
    font-size: var(--step-h3);
  }

  .about-page__list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.15rem;
    color: var(--text-secondary);
    font-size: var(--step-small);
  }

  .about-page__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1rem;
  }
</style>
