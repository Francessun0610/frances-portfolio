---
import BaseLayout from '../layouts/BaseLayout.astro';
import { person, links, PERSON_ID } from '../data/site';
import { SITE_URL } from '../config/site.mjs';

const title = 'About Frances Sun | Lead UX Designer, Educator & Speaker';
const description =
  'Frances Sun is an Austin-based Lead UX Designer, educator, and UX speaker with experience across consumer electronics, enterprise software, complex workflows, systems thinking, interaction design, and prototyping.';

// The page is about Frances, so it points at the same Person node rather than
// describing a second one.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${SITE_URL}/about#profile`,
    url: `${SITE_URL}/about`,
    name: title,
    description,
    inLanguage: 'en',
    mainEntity: { '@id': PERSON_ID },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/about"
  structuredData={structuredData}
>
  <section class="about-page">
    <div class="shell">
      <header class="about-page__head">
        <p class="eyebrow">About</p>
        <h1>{person.name}</h1>
        <p class="about-page__role">{person.role} · Educator · Speaker</p>
      </header>

      <div class="about-page__body prose">
        <p>
          I’m a Lead UX Designer who designs complex products, teaches UX, and speaks about the
          ideas behind the work. My experience spans consumer electronics and enterprise software,
          from customer-facing product experiences to operational systems and complex workflows.
        </p>

        <p>
          My work sits where business rules, operational reality, and product design meet. I start
          by understanding how a process actually works, then shape workflows, information
          architecture, interaction patterns, and prototypes that help teams see and challenge
          decisions before they are built.
        </p>

        <p>
          I work end to end with product, engineering, finance, operations, and business partners.
          Alongside product design, I teach and mentor designers, and I speak at conferences and
          universities about enterprise UX, systems thinking, product clarity, and creativity.
        </p>

        <h2 class="about-page__subhead">What I work on</h2>
        <ul class="about-page__list">
          <li>Product design for complex enterprise software and operational workflows</li>
          <li>Consumer electronics and connected product experiences</li>
          <li>Information architecture and interaction design</li>
          <li>Design systems and reusable interaction patterns</li>
          <li>Interactive prototyping and implementation-ready specifications</li>
          <li>Systems thinking across connected products</li>
        </ul>

        <p class="about-page__contact">
          <a class="text-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={links.instagram} target="_blank" rel="noopener noreferrer">
            Instagram <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={links.resume} target="_blank" rel="noopener">
            Resume <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .about-page__head {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .about-page__head h1 {
    margin-bottom: 0.75rem;
  }

  .about-page__role {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--cobalt-bright);
    font-weight: 550;
  }

  .about-page__body {
    display: grid;
    gap: 1.35rem;
  }

  /* One body color across the whole page. Hierarchy comes from headings and
     spacing, never from alternating paragraph shades. */
  .about-page__body p,
  .about-page__list {
    color: #c9ced6;
  }

  .about-page__subhead {
    margin-top: 1.25rem;
    font-size: var(--step-h3);
  }

  /* Same reading size as the biography paragraphs above. The body sets
     --step-body at 1.65 line height, and the list inherits both. */
  .about-page__list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.15rem;
  }

  .about-page__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1rem;
  }
</style>
