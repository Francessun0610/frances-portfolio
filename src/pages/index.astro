---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpeakingCard from '../components/SpeakingCard.astro';
import {
  person,
  links,
  projects,
  talksNewestFirst,
  about,
  previousWorkIntro,
  PERSON_ID,
  type Project,
} from '../data/site';
import { SITE_URL } from '../config/site.mjs';

/**
 * Reading order for the homepage only. The canonical records, including every
 * ownership and placeholder note, stay in src/data/site.ts; this decides which
 * one leads here and which three read as the surrounding body of work.
 */
const HOMEPAGE_ORDER = ['linear', 'rate-card-manager', 'atlas', 'simba'];

const bySlug = new Map(projects.map((project) => [project.slug, project]));
const ordered = HOMEPAGE_ORDER.map((slug) => bySlug.get(slug)).filter(
  (project): project is Project => Boolean(project),
);
const [leadProject, ...supportingProjects] = ordered;

const title = 'Frances Sun | Lead UX Designer & UX Speaker';
const description =
  'Frances Sun is a Lead UX Designer and UX speaker with experience across consumer electronics and enterprise software, specializing in complex workflows, systems thinking, interaction design, and hands-on prototyping.';

// The site itself, attributed to the one Person node defined in BaseLayout.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: person.name,
    url: `${SITE_URL}/`,
    inLanguage: 'en',
    publisher: { '@id': PERSON_ID },
    author: { '@id': PERSON_ID },
  },
];
---

<BaseLayout title={title} description={description} path="/" structuredData={structuredData}>
  <section class="hero">
    {/* The environment the sunrise sits in. A low navy lift weighted to the
        sunrise side, page colour held across the copy so the reading side stays
        calm, and a fade to page colour at the foot so the hero resolves into
        the work instead of ending on a rule. Painted under the drawing and
        under the text. Decorative. */}
    <div class="hero__atmosphere" aria-hidden="true"></div>

    <div class="shell hero__inner">
      <div class="hero__copy">
        <h1 class="hero__name">{person.name}</h1>
        <p class="hero__role">{person.heroRole}</p>
        <p class="hero__statement">{person.statement}</p>
        <p class="hero__supporting">{person.supporting}</p>
        <p class="hero__location">
          <span>{person.location}</span>
          <span>{person.relocation}</span>
        </p>

        <div class="hero__actions">
          <a class="button button--primary" href="#work">View selected work</a>
          <a class="button button--ghost" href="#speaking">Invite me to speak</a>
        </div>
      </div>

      {/* Decorative. The source sits below the limb, so the foreground
          occludes it. What shows is light leaking over the curve. The core is
          near the middle of the right half, clear of the copy. Nothing here
          is a sun, and nothing is focusable. data-dawn="hold" is the opening
          frame. */}
      <div class="hero__visual" aria-hidden="true">
        <svg
          class="hero__dawn"
          data-dawn="hold"
          viewBox="-140 0 840 500"
          preserveAspectRatio="xMidYMid slice"
          focusable="false"
        >
          <defs>
            {/* Limb of a circle so large the visible edge is nearly flat.
                Apex sits at y=358. Light above the limb uses a slightly
                larger radius so it stays parallel to that edge. */}
            <mask id="hs-sky" maskUnits="userSpaceOnUse" x="-200" y="-40" width="1100" height="480">
              <rect x="-200" y="-40" width="1100" height="480" fill="#fff" />
              <circle cx="220" cy="7558" r="7200" fill="#000" />
            </mask>

            {/* Peak near x=108. Left shoulder is short. Right tail is longer
                and is gone before the frame's right fade. */}
            <linearGradient id="hs-g-contact" gradientUnits="userSpaceOnUse" x1="60" y1="0" x2="230" y2="0">
              <stop offset="0" stop-color="#F3E6C8" stop-opacity="0" />
              <stop offset="0.18" stop-color="#EBD4AE" stop-opacity="0.1" />
              <stop offset="0.3" stop-color="#F6E4C4" stop-opacity="0.58" />
              <stop offset="0.52" stop-color="#E4C79A" stop-opacity="0.22" />
              <stop offset="0.78" stop-color="#C4A27A" stop-opacity="0.06" />
              <stop offset="1" stop-color="#C4A27A" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hs-g-arc" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="340" y2="0">
              <stop offset="0" stop-color="#C4A27A" stop-opacity="0" />
              <stop offset="0.16" stop-color="#C4A27A" stop-opacity="0.04" />
              <stop offset="0.32" stop-color="#E4C49A" stop-opacity="0.28" />
              <stop offset="0.4" stop-color="#F1DEC0" stop-opacity="0.4" />
              <stop offset="0.62" stop-color="#E4C49A" stop-opacity="0.14" />
              <stop offset="0.84" stop-color="#C4A27A" stop-opacity="0.04" />
              <stop offset="1" stop-color="#C4A27A" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hs-g-scatter" gradientUnits="userSpaceOnUse" x1="-40" y1="0" x2="460" y2="0">
              <stop offset="0" stop-color="#A56D45" stop-opacity="0" />
              <stop offset="0.22" stop-color="#C49262" stop-opacity="0.04" />
              <stop offset="0.34" stop-color="#E8C99A" stop-opacity="0.2" />
              <stop offset="0.55" stop-color="#DDB88A" stop-opacity="0.1" />
              <stop offset="0.8" stop-color="#C49262" stop-opacity="0.03" />
              <stop offset="1" stop-color="#A56D45" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hs-g-haze" gradientUnits="userSpaceOnUse" x1="-80" y1="0" x2="540" y2="0">
              <stop offset="0" stop-color="#7E6248" stop-opacity="0" />
              <stop offset="0.28" stop-color="#8A6A4E" stop-opacity="0.04" />
              <stop offset="0.4" stop-color="#C4A27A" stop-opacity="0.14" />
              <stop offset="0.68" stop-color="#A56D45" stop-opacity="0.05" />
              <stop offset="1" stop-color="#7E6248" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hs-g-cool" gradientUnits="userSpaceOnUse" x1="-40" y1="0" x2="680" y2="0">
              <stop offset="0" stop-color="#31465F" stop-opacity="0" />
              <stop offset="0.18" stop-color="#526C8B" stop-opacity="0.06" />
              <stop offset="0.45" stop-color="#7E94AA" stop-opacity="0.08" />
              <stop offset="0.72" stop-color="#7E94AA" stop-opacity="0.06" />
              <stop offset="1" stop-color="#31465F" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hs-g-sky" gradientUnits="userSpaceOnUse" x1="160" y1="370" x2="160" y2="40">
              <stop offset="0" stop-color="#31465F" stop-opacity="0.1" />
              <stop offset="0.55" stop-color="#1a2433" stop-opacity="0.03" />
              <stop offset="1" stop-color="#0b0d12" stop-opacity="0" />
            </linearGradient>
            <radialGradient id="hs-g-warmth" gradientUnits="userSpaceOnUse" cx="120" cy="330" r="200">
              <stop offset="0" stop-color="#E4C49A" stop-opacity="0.14" />
              <stop offset="0.42" stop-color="#A56D45" stop-opacity="0.05" />
              <stop offset="1" stop-color="#A56D45" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-g-core" gradientUnits="userSpaceOnUse" cx="108" cy="360.4" r="11">
              <stop offset="0" stop-color="#F7F3EA" stop-opacity="1" />
              <stop offset="0.45" stop-color="#E8C99A" stop-opacity="0.58" />
              <stop offset="1" stop-color="#E4C49A" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-g-leak" gradientUnits="userSpaceOnUse" cx="124" cy="365" r="32">
              <stop offset="0" stop-color="#F4EBDA" stop-opacity="0.62" />
              <stop offset="0.5" stop-color="#E4C49A" stop-opacity="0.22" />
              <stop offset="1" stop-color="#C4A27A" stop-opacity="0" />
            </radialGradient>

            {/* Static, tight blurs. More vertical feather than horizontal
                smear, so a buried source leaks as a point instead of a disc. */}
            <filter id="hs-f-core" filterUnits="userSpaceOnUse" x="78" y="336" width="70" height="50">
              <feGaussianBlur stdDeviation="1.5 2.6" />
            </filter>
            <filter id="hs-f-leak" filterUnits="userSpaceOnUse" x="50" y="330" width="180" height="70">
              <feGaussianBlur stdDeviation="7 3.2" />
            </filter>
            <filter id="hs-f-contact" filterUnits="userSpaceOnUse" x="20" y="300" width="280" height="90">
              <feGaussianBlur stdDeviation="2.2 3.2" />
            </filter>
            <filter id="hs-f-arc" filterUnits="userSpaceOnUse" x="-40" y="280" width="460" height="120">
              <feGaussianBlur stdDeviation="3.4 4.6" />
            </filter>
            <filter id="hs-f-scatter" filterUnits="userSpaceOnUse" x="-80" y="250" width="620" height="160">
              <feGaussianBlur stdDeviation="6 7.5" />
            </filter>
            <filter id="hs-f-haze" filterUnits="userSpaceOnUse" x="-140" y="180" width="780" height="230">
              <feGaussianBlur stdDeviation="14 15" />
            </filter>
            <filter id="hs-f-cool" filterUnits="userSpaceOnUse" x="-220" y="270" width="1160" height="150">
              <feGaussianBlur stdDeviation="8 6.5" />
            </filter>
            <filter id="hs-f-warmth" filterUnits="userSpaceOnUse" x="-40" y="80" width="420" height="320">
              <feGaussianBlur stdDeviation="10 12" />
            </filter>
          </defs>

          <g mask="url(#hs-sky)">
            <rect class="hs-cool" x="-160" y="0" width="900" height="390" fill="url(#hs-g-sky)" />
            <g class="hs-cool">
              <path d="M -180 357.1 A 7212 7212 0 0 1 700 361.99" fill="none" stroke="url(#hs-g-cool)" stroke-width="16" filter="url(#hs-f-cool)" />
            </g>
            <g class="hs-warmth">
              <ellipse cx="124" cy="328" rx="170" ry="78" fill="url(#hs-g-warmth)" filter="url(#hs-f-warmth)" />
            </g>
            <g class="hs-haze">
              <path d="M -90 318.63 A 7246 7246 0 0 1 520 318.21" fill="none" stroke="url(#hs-g-haze)" stroke-width="30" filter="url(#hs-f-haze)" />
            </g>
            <g class="hs-scatter">
              <path d="M -30 340.33 A 7222 7222 0 0 1 440 339.35" fill="none" stroke="url(#hs-g-scatter)" stroke-width="22" filter="url(#hs-f-scatter)" />
            </g>
            <g class="hs-arc">
              <path d="M 20 351.77 A 7209 7209 0 0 1 320 349.69" fill="none" stroke="url(#hs-g-arc)" stroke-width="13" filter="url(#hs-f-arc)" />
            </g>
            <g class="hs-contact">
              <path d="M 70 356.06 A 7203.5 7203.5 0 0 1 200 354.53" fill="none" stroke="url(#hs-g-contact)" stroke-width="8" filter="url(#hs-f-contact)" />
            </g>
            {/* Buried below the limb. The mask keeps the body hidden; only
                the upper fringe can cross into the sky. */}
            <g class="hs-leak">
              <ellipse cx="124" cy="365" rx="16" ry="3.4" fill="url(#hs-g-leak)" filter="url(#hs-f-leak)" />
            </g>
            <g class="hs-core">
              <ellipse cx="108" cy="360.4" rx="6.5" ry="2.2" fill="url(#hs-g-core)" filter="url(#hs-f-core)" />
            </g>
          </g>

          {/* Foreground is page colour. It covers any light that falls below
              the limb, so the glow stays in the sky. */}
          <circle cx="220" cy="7558" r="7200" fill="#0b0d12" />
        </svg>
      </div>
    </div>
  </section>

  {/* One 18s entrance on load. It does not restart when the hero scrolls away. */}
  <script is:inline>
    (() => {
      const scene = document.querySelector('[data-dawn]');
      if (!scene) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      requestAnimationFrame(() => {
        scene.dataset.dawn = 'run';
      });
    })();
  </script>

  {/* Same structural hairline as Selected Work → Speaking. The hero atmosphere
      has already resolved to page colour at its foot, so the rule sits on dark
      page, not through the glow. */}
  <hr class="divider" />

  <section class="section section--work" id="work" aria-labelledby="work-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="work-heading">Selected Work</h2>
        <p>
          Product design across consumer electronics, enterprise software, and complex operational
          workflows.
        </p>
      </header>

      {leadProject && <ProjectCard project={leadProject} layout="wide" priority />}

      <div class="work-grid">
        {supportingProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="speaking" aria-labelledby="speaking-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="speaking-heading">Speaking</h2>
        <p>
          Conference and university talks on enterprise UX, systems thinking, product clarity, and
          creative problem solving.
        </p>
      </header>

      <div class="speaking-grid">
        {/* The grid is two up, so it shows the two most recent talks rather
            than leaving a third stranded on its own row. The rest are one
            click away. */}
        {talksNewestFirst.slice(0, 2).map((talk) => <SpeakingCard talk={talk} />)}
      </div>

      <p class="speaking-more">
        <a class="text-link" href="/speaking">View talks <span aria-hidden="true">→</span></a>
      </p>
      <div class="speaking-inquiry">
        <p>For conference, university, and UX community speaking inquiries.</p>
        <p>
          <a class="text-link" href="mailto:francessun@gmail.com?subject=Speaking%20Inquiry%20for%20Frances%20Sun">
            Speaking inquiry <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section section--tight" id="previous-work" aria-labelledby="previous-heading">
    <div class="shell previous">
      <h2 id="previous-heading" class="previous__heading">Previous Work</h2>
      <div class="previous__body">
        <p class="previous__copy">{previousWorkIntro.copy}</p>
        <p>
          <a class="text-link" href={previousWorkIntro.href}>
            {previousWorkIntro.cta} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="shell about">
      <h2 id="about-heading">About</h2>
      <div class="about__body">
        <p class="lede">{about.homepage}</p>
        <p class="about__links">
          <a class="text-link" href="/about">More about Frances <span aria-hidden="true">→</span></a>
          <a class="text-link" href={links.resume} target="_blank" rel="noopener noreferrer">
            Resume <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </div>
  </section>
  <script>
    const saved = sessionStorage.getItem('fs-linear-scroll');
    const returning = sessionStorage.getItem('fs-linear-return') === '1';
    document.querySelectorAll('a[href^="/work/linear"]').forEach((link) => {
      link.addEventListener('click', () => {
        sessionStorage.setItem('fs-linear-scroll', String(window.scrollY));
      });
    });
    const hash = location.hash;
    if (hash === '#card-linear' || (returning && hash === '#work')) {
      sessionStorage.removeItem('fs-linear-scroll');
      sessionStorage.removeItem('fs-linear-return');
      const card = document.getElementById('card-linear');
      requestAnimationFrame(() => {
        if (saved) window.scrollTo(0, Number(saved));
        card?.focus({ preventScroll: Boolean(saved) });
      });
    }
  </script>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    /* Symmetric in and out, so the light has no discernible start or end. */
    --ease-breathe: cubic-bezier(0.45, 0, 0.55, 1);
  }

  /* Spans the window rather than the shell, so the environment is the hero
     itself and not a panel inside it. Under the drawing and under the copy. */
  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      /* Foot: resolves to page colour before the work starts. */
      linear-gradient(180deg, rgba(11, 13, 18, 0) 48%, rgba(11, 13, 18, 0.55) 78%, var(--bg) 100%),
      /* Reading side: page colour held flat across the text measure, then
         released. Listed first among the side washes so it only ever
         subtracts light. */
      linear-gradient(
        90deg,
        var(--bg) 0%,
        var(--bg) 38%,
        rgba(11, 13, 18, 0.92) 52%,
        rgba(11, 13, 18, 0.35) 68%,
        rgba(11, 13, 18, 0) 82%
      ),
      /* Cool night air that bridges the two sides. Dim enough to never
         compete with the copy, wide enough that the hero reads as one field
         rather than a text column next to a graphic. */
      radial-gradient(
        140% 90% at 62% 62%,
        rgba(22, 34, 52, 0.42) 0%,
        rgba(14, 20, 32, 0.22) 38%,
        rgba(11, 13, 18, 0) 72%
      ),
      /* Sunrise-side lift. Brighter mass stays on the right. */
      radial-gradient(
        110% 75% at 78% 58%,
        rgba(27, 44, 68, 0.55) 0%,
        rgba(17, 24, 39, 0.28) 42%,
        rgba(11, 13, 18, 0) 74%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    /* Unchanged. The foot of the hero is no longer empty: the atmosphere above
       resolves to page colour across it, which is the transition into the
       work. */
    padding-block: clamp(3.5rem, 2.5rem + 6vw, 7.5rem) clamp(3rem, 2rem + 5vw, 6rem);
  }

  .hero__copy {
    max-width: 44rem;
  }

  .hero__name {
    margin-bottom: 0.9rem;
  }

  .hero__role {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    font-weight: 550;
    color: var(--cobalt-bright);
    letter-spacing: -0.008em;
  }

  /* The positioning line, treated as a brand statement rather than body copy.
     The measure is set so the sentence resolves to two balanced lines on every
     desktop and laptop width; three lines is a layout failure, so the grid
     below gives this column the room instead of trimming the type. */
  .hero__statement {
    margin-top: 1.5rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.62vw, 1.5rem);
    line-height: 1.38;
    letter-spacing: -0.014em;
    color: var(--text);
    max-width: 46ch;
    text-wrap: balance;
  }

  .hero__supporting {
    margin-top: 1.15rem;
    max-width: 58ch;
    color: var(--text-secondary);
  }

  .hero__location {
    margin-top: 1.15rem;
    font-size: var(--step-small);
    color: var(--text-tertiary);
  }

  /* Two sentences, one block. Each sits on its own line without adding
     spacing between them, and each still wraps normally on a narrow screen. */
  .hero__location span {
    display: block;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Decorative only. Below the two-column breakpoint it is a short band
     under the copy — a deliberate fragment of the horizon, not a shrink. */
  .hero__visual {
    position: relative;
    width: 100%;
    height: clamp(7rem, 28vw, 10rem);
    overflow: hidden;
    pointer-events: none;
  }

  .hero__dawn {
    position: absolute;
    top: 0;
    right: 0;
    width: min(100%, 34rem);
    height: auto;
    aspect-ratio: 7 / 5;
    /* Lifts the frame so the band opens on the sunrise and the limb. */
    transform: translateY(-34%);
    display: block;
    /* Band crop dissolves on all cut edges so the rectangle never reads. */
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 18%, #000 96%, transparent 100%),
      linear-gradient(180deg, transparent 8%, #000 28%, #000 78%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 18%, #000 96%, transparent 100%),
      linear-gradient(180deg, transparent 8%, #000 28%, #000 78%, transparent 100%);
    mask-composite: intersect;
    --dawn: 18s;
    --ease-dawn: linear;
  }

  /* Below the two-column layout the drawing is a shallow band, so the faintest
     outer haze and the widest lateral band have no room to read as atmosphere
     and only muddy the crop. They are pulled back rather than rescaled, which
     is what keeps the band a deliberate fragment instead of a shrunken
     desktop composition. */
  @media (max-width: 899px) {
    .hs-far {
      opacity: 0.55;
    }
  }

  /* Clears the sticky header when the hero link jumps here. Top padding matches
     Selected Work after its divider so both section breaks share one rhythm. */
  #speaking {
    scroll-margin-top: 5.5rem;
    padding-top: clamp(2.5rem, 2rem + 1.6vw, 3.25rem);
  }

  /* Two columns. The copy keeps the larger share at every width because the
     statement's line count outranks the size of the visual. */
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.55fr);
      align-items: center;
      gap: 2.75rem;
    }

    /* The track still reserves the right column, and therefore still fixes the
       width of the copy column, but it no longer carries a size the drawing
       has to respect: the drawing is taken out of flow below and positions
       against .hero instead. */
    .hero__visual {
      justify-self: end;
      width: min(100%, 17.5rem);
      height: auto;
      aspect-ratio: 8 / 5;
      position: static;
      overflow: visible;
    }

    /* One cinematic frame rather than a graphic box. It spans from a fixed
       offset right of the copy to a little past the window, so the horizon is
       cropped by the window rather than ending inside the page, and it grows
       with the window instead of with the column. Because it is absolutely
       positioned it contributes nothing to the grid, so the copy cannot move
       however large this gets. Both offsets are in rem, so the frame tracks
       the shell under zoom.

       An SVG is a replaced element, so the width has to be stated: with width
       auto the intrinsic size wins and the right offset is dropped. Because
       the shell is centred, the left offset and vw width are paired so the
       right edge always lands 1.5rem past the window. The width has to be in
       vw, not %, or it would resolve against the shell and stop growing once
       the shell hits its max. */
    .hero__dawn {
      top: 50%;
      left: calc(50% + 8.5rem);
      right: auto;
      width: calc(50vw - 7rem);
      max-width: none;
      height: auto;
      aspect-ratio: 7 / 5;
      transform: translateY(-50%);
      /* Deep left fade: the dim horizon may reach back toward the copy, but the
         warm light has to be off the text before the longest line ends. The
         atmosphere layer behind the hero now carries the leftward continuity,
         so this edge can stay conservative. Long trailing fade so the window
         edge does not cut the light. */
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 26%, #000 84%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 26%, #000 84%, transparent 100%);
    }
  }

  /* More room overall, so the field can take a little back. */
  @media (min-width: 1200px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.32fr) minmax(0, 0.68fr);
      gap: 4rem;
    }

    .hero__visual {
      width: min(100%, 23rem);
    }

    /* The copy column takes a smaller share above this width, so the frame
       starts further left and is correspondingly wider. The right edge still
       resolves to 100% + 1.5rem. */
    .hero__dawn {
