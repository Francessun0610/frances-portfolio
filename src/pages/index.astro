---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpeakingCard from '../components/SpeakingCard.astro';
import {
  person,
  links,
  projects,
  talksNewestFirst,
  about,
  previousWorkIntro,
  PERSON_ID,
} from '../data/site';
import { SITE_URL } from '../config/site.mjs';

const title = 'Frances Sun | Lead UX Designer & UX Speaker';
const description =
  'Frances Sun is a Lead UX Designer and UX speaker with experience across consumer electronics and enterprise software, specializing in complex workflows, systems thinking, interaction design, and hands-on prototyping.';

// The site itself, attributed to the one Person node defined in BaseLayout.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: person.name,
    url: `${SITE_URL}/`,
    inLanguage: 'en',
    publisher: { '@id': PERSON_ID },
    author: { '@id': PERSON_ID },
  },
];
---

<BaseLayout title={title} description={description} path="/" structuredData={structuredData}>
  <section class="hero">
    <div class="shell hero__inner">
      <div class="hero__copy">
        <h1 class="hero__name">{person.name}</h1>
        <p class="hero__role">{person.heroRole}</p>
        <p class="hero__statement">{person.statement}</p>
        <p class="hero__supporting">{person.supporting}</p>
        <p class="hero__location">
          <span>{person.location}</span>
          <span>{person.relocation}</span>
        </p>

        <div class="hero__actions">
          <a class="button button--primary" href="#work">View selected work</a>
          <a class="button button--ghost" href="#speaking">Invite me to speak</a>
        </div>
      </div>

      {/* Decorative. A sunrise behind one horizon arc. The arc's body is the
          page color, so it reads as an edge of light, not a drawn planet. */}
      <div class="hero__visual" aria-hidden="true">
        <div class="hero__dawn">
          <div class="hero__sun">
            <span class="hero__sun-haze"></span>
            <span class="hero__sun-bloom"></span>
            <span class="hero__sun-core"></span>
          </div>
          <svg class="hero__arc" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <defs>
              <linearGradient id="hero-horizon" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#9bb0c8" stop-opacity="0" />
                <stop offset="22%" stop-color="#a9bfd4" stop-opacity="0.22" />
                <stop offset="42%" stop-color="#d7e2ee" stop-opacity="0.45" />
                <stop offset="50%" stop-color="#ffe4a0" stop-opacity="0.95" />
                <stop offset="58%" stop-color="#d7e2ee" stop-opacity="0.45" />
                <stop offset="78%" stop-color="#a9bfd4" stop-opacity="0.22" />
                <stop offset="100%" stop-color="#9bb0c8" stop-opacity="0" />
              </linearGradient>
              <filter id="hero-horizon-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="1.6" />
              </filter>
            </defs>
            <ellipse cx="210" cy="408" rx="460" ry="156" fill="#0b0d12" />
            <ellipse
              cx="210"
              cy="408"
              rx="460"
              ry="156"
              fill="none"
              stroke="#7f9bb8"
              stroke-width="7"
              stroke-opacity="0.16"
              filter="url(#hero-horizon-glow)"></ellipse>
            <ellipse
              cx="210"
              cy="408"
              rx="460"
              ry="156"
              fill="none"
              stroke="url(#hero-horizon)"
              stroke-width="1.15"></ellipse>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="work" aria-labelledby="work-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="work-heading">Selected Work</h2>
        <p>
          Product design across consumer electronics, enterprise software, and complex operational
          workflows.
        </p>
      </header>

      <div class="work-grid">
        {projects.map((project, index) => <ProjectCard project={project} priority={index === 0} />)}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="speaking" aria-labelledby="speaking-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="speaking-heading">Speaking</h2>
        <p>
          Conference and university talks on enterprise UX, systems thinking, product clarity, and
          creative problem solving.
        </p>
      </header>

      <div class="speaking-grid">
        {/* The grid is two up, so it shows the two most recent talks rather
            than leaving a third stranded on its own row. The rest are one
            click away. */}
        {talksNewestFirst.slice(0, 2).map((talk) => <SpeakingCard talk={talk} />)}
      </div>

      <p class="speaking-more">
        <a class="text-link" href="/speaking">View talks <span aria-hidden="true">→</span></a>
      </p>
      <div class="speaking-inquiry">
        <p>For conference, university, and UX community speaking inquiries.</p>
        <p>
          <a class="text-link" href="mailto:francessun@gmail.com?subject=Speaking%20Inquiry%20for%20Frances%20Sun">
            Speaking inquiry <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section section--tight" id="previous-work" aria-labelledby="previous-heading">
    <div class="shell previous">
      <h2 id="previous-heading" class="previous__heading">Previous Work</h2>
      <div class="previous__body">
        <p class="previous__copy">{previousWorkIntro.copy}</p>
        <p>
          <a class="text-link" href={previousWorkIntro.href}>
            {previousWorkIntro.cta} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="shell about">
      <h2 id="about-heading">About</h2>
      <div class="about__body">
        <p class="lede">{about.homepage}</p>
        <p class="about__links">
          <a class="text-link" href="/about">More about Frances <span aria-hidden="true">→</span></a>
          <a class="text-link" href={links.resume} target="_blank" rel="noopener">
            Resume <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    /* Symmetric in and out, so the light has no discernible start or end. */
    --ease-breathe: cubic-bezier(0.45, 0, 0.55, 1);
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: 2rem;
    padding-block: clamp(3.5rem, 2.5rem + 6vw, 7.5rem) clamp(3rem, 2rem + 5vw, 6rem);
  }

  .hero__copy {
    max-width: 44rem;
  }

  .hero__name {
    margin-bottom: 0.9rem;
  }

  .hero__role {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    font-weight: 550;
    color: var(--cobalt-bright);
    letter-spacing: -0.008em;
  }

  /* The positioning line, treated as a brand statement rather than body copy.
     The measure is set so the sentence resolves to two balanced lines on every
     desktop and laptop width; three lines is a layout failure, so the grid
     below gives this column the room instead of trimming the type. */
  .hero__statement {
    margin-top: 1.5rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.62vw, 1.5rem);
    line-height: 1.38;
    letter-spacing: -0.014em;
    color: var(--text);
    max-width: 46ch;
    text-wrap: balance;
  }

  .hero__supporting {
    margin-top: 1.15rem;
    max-width: 58ch;
    color: var(--text-secondary);
  }

  .hero__location {
    margin-top: 1.15rem;
    font-size: var(--step-small);
    color: var(--text-tertiary);
  }

  /* Two sentences, one block. Each sits on its own line without adding
     spacing between them, and each still wraps normally on a narrow screen. */
  .hero__location span {
    display: block;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Decorative only: layered light, no imagery, no parallax. Below the
     two-column breakpoint the copy carries the hero on its own. */
  .hero__visual {
    display: none;
  }

  /* Clears the sticky header when the hero link jumps here. Resting
     spacing of the section is unchanged. */
  #speaking {
    scroll-margin-top: 5.5rem;
  }

  /* Two columns. The copy keeps the larger share at every width because the
     statement's line count outranks the size of the visual. */
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.55fr);
      align-items: center;
      gap: 2.75rem;
    }

    .hero__visual {
      display: block;
      position: relative;
      justify-self: end;
      width: min(100%, 17.5rem);
      aspect-ratio: 1 / 1;
      overflow: hidden;
    }
  }

  /* More room overall, so the field can take a little back. */
  @media (min-width: 1200px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.32fr) minmax(0, 0.68fr);
      gap: 4rem;
    }

    .hero__visual {
      width: min(100%, 22rem);
    }
  }

  /* The light sits behind the arc. It rises once, then only the outer
     haze keeps breathing. The visual box clips it, so it cannot reach
     the copy. */
  .hero__dawn {
    position: absolute;
    inset: 0;
  }

  .hero__sun {
    position: absolute;
    left: 58%;
    top: 4%;
    width: 84%;
    height: 64%;
    transform: translate(-50%, 0);
    animation: sunrise 3s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero__sun-haze,
  .hero__sun-bloom,
  .hero__sun-core {
    position: absolute;
    display: block;
  }

  .hero__sun-haze {
    inset: 0 4% 0;
    opacity: 0.8;
    background: radial-gradient(
      ellipse 70% 62% at 50% 78%,
      rgba(255, 215, 106, 0.42) 0%,
      rgba(248, 184, 78, 0.14) 36%,
      rgba(248, 184, 78, 0) 70%
    );
    filter: blur(16px);
    animation: dawn-breathe 10s var(--ease-breathe) 3s infinite;
  }

  .hero__sun-bloom {
    left: 8%;
    right: 8%;
    bottom: 8%;
    height: 55%;
    background: radial-gradient(
      ellipse 70% 80% at 50% 88%,
      rgba(255, 228, 160, 0.28) 0%,
      rgba(248, 184, 78, 0.1) 46%,
      rgba(248, 184, 78, 0) 76%
    );
    filter: blur(14px);
  }

  .hero__sun-core {
    left: 28%;
    width: 44%;
    bottom: 10%;
    height: 34%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 62%,
      rgba(255, 236, 196, 0.32) 0%,
      rgba(255, 215, 106, 0.1) 38%,
      rgba(248, 184, 78, 0) 70%
    );
    filter: blur(6px);
  }

  .hero__arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The offset lives only in the first keyframe. With the animation off,
     the declared transform above is the finished sunrise. */
  @keyframes sunrise {
    from {
      transform: translate(-50%, 0) translateY(22px);
    }
    to {
      transform: translate(-50%, 0);
    }
  }

  @keyframes dawn-breathe {
    0%,
    100% {
      opacity: 0.8;
      transform: scale(1);
    }
    50% {
      opacity: 0.88;
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__sun,
    .hero__sun-haze {
      animation: none;
    }
  }

  /* ---------- Sections ---------- */

  /* Title and subtitle read as one unit. The subtitle stays under the
     heading at every width, never in a second column. */
  .section-intro {
    margin-bottom: clamp(1.75rem, 1.2rem + 2vw, 3rem);
  }

  .section-intro p {
    margin: 0.6rem 0 0;
    max-width: 42rem;
    font-size: var(--step-small);
    color: var(--text-secondary);
  }

  .work-grid,
  .speaking-grid {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  @media (min-width: 900px) {
    .work-grid,
    .speaking-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .speaking-more {
    margin-top: 1.35rem;
  }

  .speaking-inquiry {
    margin-top: clamp(2.5rem, 2rem + 1.5vw, 3.25rem);
  }

  .speaking-inquiry p {
    margin: 0;
  }

  .speaking-inquiry p:first-child {
    max-width: 42rem;
    font-size: var(--step-small);
    color: var(--text-tertiary);
  }

  .speaking-inquiry p + p {
    margin-top: 0.55rem;
  }

  /* ---------- Previous work: deliberately quieter ---------- */

  .previous {
    display: grid;
    gap: 1rem;
  }

  .previous__heading {
    font-size: clamp(1.375rem, 1.25rem + 0.6vw, 1.75rem);
  }

  .previous__body {
    display: grid;
    gap: 0.9rem;
  }

  .previous__copy {
    max-width: none;
    font-size: var(--step-small);
    color: var(--text-secondary);
  }

  @media (min-width: 900px) {
    .previous {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }

  /* ---------- About ---------- */

  .about {
    display: grid;
    gap: 1.25rem;
  }

  .about__body {
    display: grid;
    gap: 1.5rem;
    max-width: 68ch;
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }
</style>
