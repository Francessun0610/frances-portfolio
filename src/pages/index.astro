---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpeakingCard from '../components/SpeakingCard.astro';
import {
  person,
  links,
  projects,
  talksNewestFirst,
  about,
  previousWorkIntro,
  PERSON_ID,
  type Project,
} from '../data/site';
import { SITE_URL } from '../config/site.mjs';

/**
 * Reading order for the homepage only. The canonical records, including every
 * ownership and placeholder note, stay in src/data/site.ts; this decides which
 * one leads here and which three read as the surrounding body of work.
 */
const HOMEPAGE_ORDER = ['linear', 'rate-card-manager', 'atlas', 'simba'];

const bySlug = new Map(projects.map((project) => [project.slug, project]));
const ordered = HOMEPAGE_ORDER.map((slug) => bySlug.get(slug)).filter(
  (project): project is Project => Boolean(project),
);
const [leadProject, ...supportingProjects] = ordered;

const title = 'Frances Sun | Lead UX Designer & UX Speaker';
const description =
  'Frances Sun is a Lead UX Designer and UX speaker with experience across consumer electronics and enterprise software, specializing in complex workflows, systems thinking, interaction design, and hands-on prototyping.';

// The site itself, attributed to the one Person node defined in BaseLayout.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: person.name,
    url: `${SITE_URL}/`,
    inLanguage: 'en',
    publisher: { '@id': PERSON_ID },
    author: { '@id': PERSON_ID },
  },
];
---

<BaseLayout title={title} description={description} path="/" structuredData={structuredData}>
  <section class="hero">
    {/* The environment the sunrise sits in. A low navy lift weighted to the
        sunrise side, page colour held across the copy so the reading side stays
        calm, and a fade to page colour at the foot so the hero resolves into
        the work instead of ending on a rule. Painted under the drawing and
        under the text. Decorative. */}
    <div class="hero__atmosphere" aria-hidden="true"></div>

    <div class="shell hero__inner">
      <div class="hero__copy">
        <h1 class="hero__name">{person.name}</h1>
        <p class="hero__role">{person.heroRole}</p>
        <p class="hero__statement">{person.statement}</p>
        <p class="hero__supporting">{person.supporting}</p>
        <p class="hero__location">
          <span>{person.location}</span>
          <span>{person.relocation}</span>
        </p>

        <div class="hero__actions">
          <a class="button button--primary" href="#work">View selected work</a>
          <a class="button button--ghost" href="#speaking">Invite me to speak</a>
        </div>
      </div>

      {/* Decorative. The source sits below the limb, so the foreground
          occludes it. Warm light is revealed from that point outward along
          the same horizon. Nothing here is a sun, and nothing is focusable.
          data-dawn="hold" is the opening frame. */}
      <div class="hero__visual" aria-hidden="true">
        <svg
          class="hero__dawn"
          data-dawn="hold"
          viewBox="-140 0 840 500"
          preserveAspectRatio="xMidYMid slice"
          focusable="false"
        >
          <defs>
            {/* Limb of a circle so large the visible edge is nearly flat.
                Apex sits near y=358. Everything warm is painted above that
                limb and then covered again by the foreground, so the source
                stays behind the horizon. */}
            <mask id="hs-sky" maskUnits="userSpaceOnUse" x="-220" y="-80" width="1200" height="520">
              <rect x="-220" y="-80" width="1200" height="520" fill="#fff" />
              <circle cx="220" cy="7558" r="7200" fill="#000" />
            </mask>

            {/* One cool wash. No stroked horizon. */}
            <linearGradient id="hs-g-cool" gradientUnits="userSpaceOnUse" x1="0" y1="20" x2="0" y2="370">
              <stop offset="0" stop-color="#0b0d12" stop-opacity="0" />
              <stop offset="0.62" stop-color="#1a2838" stop-opacity="0.04" />
              <stop offset="1" stop-color="#31465f" stop-opacity="0.14" />
            </linearGradient>

            {/* Oversized fields. Colour is gone long before the paint
                rectangle, so the geometry never reads as an edge. */}
            <radialGradient id="hs-g-veil" gradientUnits="userSpaceOnUse" cx="560" cy="280" r="720" fx="250" fy="350" gradientTransform="translate(250 350) scale(1.2 0.62) translate(-250 -350)">
              <stop offset="0" stop-color="#f4e6cc" stop-opacity="0.07" />
              <stop offset="0.2" stop-color="#e6d2b2" stop-opacity="0.035" />
              <stop offset="0.46" stop-color="#7f96aa" stop-opacity="0.016" />
              <stop offset="0.72" stop-color="#1a2432" stop-opacity="0.006" />
              <stop offset="1" stop-color="#0b0d12" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-g-haze" gradientUnits="userSpaceOnUse" cx="640" cy="160" r="1100" fx="300" fy="300">
              <stop offset="0" stop-color="#e7d4b4" stop-opacity="0.055" />
              <stop offset="0.22" stop-color="#9aafc2" stop-opacity="0.028" />
              <stop offset="0.48" stop-color="#2a3c50" stop-opacity="0.016" />
              <stop offset="0.74" stop-color="#121820" stop-opacity="0.006" />
              <stop offset="1" stop-color="#0b0d12" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-g-lift" gradientUnits="userSpaceOnUse" cx="760" cy="80" r="900" fx="420" fy="260">
              <stop offset="0" stop-color="#c9b89a" stop-opacity="0.04" />
              <stop offset="0.3" stop-color="#6e8498" stop-opacity="0.02" />
              <stop offset="0.62" stop-color="#1c2836" stop-opacity="0.01" />
              <stop offset="1" stop-color="#0b0d12" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-g-main" gradientUnits="userSpaceOnUse" cx="470" cy="390" r="860" fx="250" fy="356" gradientTransform="translate(250 356) scale(1.35 0.5) translate(-250 -356)">
              <stop offset="0" stop-color="#f7f3ea" stop-opacity="0.2" />
              <stop offset="0.08" stop-color="#f3e2c4" stop-opacity="0.11" />
              <stop offset="0.2" stop-color="#e4cba8" stop-opacity="0.055" />
              <stop offset="0.38" stop-color="#b7a890" stop-opacity="0.028" />
              <stop offset="0.58" stop-color="#6d8498" stop-opacity="0.014" />
              <stop offset="0.78" stop-color="#1a2432" stop-opacity="0.005" />
              <stop offset="1" stop-color="#0b0d12" stop-opacity="0" />
            </radialGradient>

            {/* Tiny leak, centered below the limb. Only the fringe crosses. */}
            <radialGradient id="hs-g-contact" gradientUnits="userSpaceOnUse" cx="250" cy="364" r="16">
              <stop offset="0" stop-color="#f8f6f1" stop-opacity="0.9" />
              <stop offset="0.4" stop-color="#f3dcb4" stop-opacity="0.35" />
              <stop offset="1" stop-color="#e8c99a" stop-opacity="0" />
            </radialGradient>
            <filter id="hs-f-contact" filterUnits="userSpaceOnUse" x="216" y="346" width="70" height="32">
              <feGaussianBlur stdDeviation="1.2 0.9" />
            </filter>
          </defs>

          <g mask="url(#hs-sky)">
            <g class="hs-cool">
              <rect x="-200" y="0" width="1040" height="400" fill="url(#hs-g-cool)" />
            </g>
            <g class="hs-haze">
              <rect x="-500" y="-280" width="1800" height="820" fill="url(#hs-g-haze)" />
            </g>
            <g class="hs-lift">
              <rect x="-500" y="-280" width="1800" height="820" fill="url(#hs-g-lift)" />
            </g>
            <g class="hs-veil">
              <rect x="-500" y="-280" width="1800" height="820" fill="url(#hs-g-veil)" />
            </g>
            <g class="hs-main">
              <rect x="-500" y="-280" width="1800" height="820" fill="url(#hs-g-main)" />
            </g>
            <g class="hs-contact">
              <ellipse cx="250" cy="366" rx="18" ry="2" fill="url(#hs-g-contact)" filter="url(#hs-f-contact)" />
            </g>
          </g>

          {/* Foreground is page colour. It covers any light that falls below
              the limb, so the glow stays in the sky. */}
          <circle cx="220" cy="7558" r="7200" fill="#0b0d12" />
        </svg>
      </div>
    </div>
  </section>

  {/* One 23s entrance on load. It does not restart when the hero scrolls away.
      After it settles, only the air drifts. */}
  <script is:inline>
    (() => {
      const scene = document.querySelector('[data-dawn]');
      if (!scene) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      requestAnimationFrame(() => {
        scene.dataset.dawn = 'run';
      });
    })();
  </script>

  {/* Same structural hairline as Selected Work → Speaking. The hero atmosphere
      has already resolved to page colour at its foot, so the rule sits on dark
      page, not through the glow. */}
  <hr class="divider" />

  <section class="section section--work" id="work" aria-labelledby="work-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="work-heading">Selected Work</h2>
        <p>
          Product design across consumer electronics, enterprise software, and complex operational
          workflows.
        </p>
      </header>

      {leadProject && <ProjectCard project={leadProject} layout="wide" priority />}

      <div class="work-grid">
        {supportingProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="speaking" aria-labelledby="speaking-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="speaking-heading">Speaking</h2>
        <p>
          Conference and university talks on enterprise UX, systems thinking, product clarity, and
          creative problem solving.
        </p>
      </header>

      <div class="speaking-grid">
        {/* The grid is two up, so it shows the two most recent talks rather
            than leaving a third stranded on its own row. The rest are one
            click away. */}
        {talksNewestFirst.slice(0, 2).map((talk) => <SpeakingCard talk={talk} />)}
      </div>

      <p class="speaking-more">
        <a class="text-link" href="/speaking">View talks <span aria-hidden="true">→</span></a>
      </p>
      <div class="speaking-inquiry">
        <p>For conference, university, and UX community speaking inquiries.</p>
        <p>
          <a class="text-link" href="mailto:francessun@gmail.com?subject=Speaking%20Inquiry%20for%20Frances%20Sun">
            Speaking inquiry <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section section--tight" id="previous-work" aria-labelledby="previous-heading">
    <div class="shell previous">
      <h2 id="previous-heading" class="previous__heading">Previous Work</h2>
      <div class="previous__body">
        <p class="previous__copy">{previousWorkIntro.copy}</p>
        <p>
          <a class="text-link" href={previousWorkIntro.href}>
            {previousWorkIntro.cta} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="shell about">
      <h2 id="about-heading">About</h2>
      <div class="about__body">
        <p class="lede">{about.homepage}</p>
        <p class="about__links">
          <a class="text-link" href="/about">More about Frances <span aria-hidden="true">→</span></a>
          <a class="text-link" href={links.resume} target="_blank" rel="noopener noreferrer">
            Resume <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </div>
  </section>
  <script>
    const saved = sessionStorage.getItem('fs-linear-scroll');
    const returning = sessionStorage.getItem('fs-linear-return') === '1';
    document.querySelectorAll('a[href^="/work/linear"]').forEach((link) => {
      link.addEventListener('click', () => {
        sessionStorage.setItem('fs-linear-scroll', String(window.scrollY));
      });
    });
    const hash = location.hash;
    if (hash === '#card-linear' || (returning && hash === '#work')) {
      sessionStorage.removeItem('fs-linear-scroll');
      sessionStorage.removeItem('fs-linear-return');
      const card = document.getElementById('card-linear');
      requestAnimationFrame(() => {
        if (saved) window.scrollTo(0, Number(saved));
        card?.focus({ preventScroll: Boolean(saved) });
      });
    }
  </script>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    /* Symmetric in and out, so the light has no discernible start or end. */
    --ease-breathe: cubic-bezier(0.45, 0, 0.55, 1);
  }

  /* Spans the window rather than the shell, so the environment is the hero
     itself and not a panel inside it. Under the drawing and under the copy. */
  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      /* Foot: resolves to page colour before the work starts. */
      linear-gradient(180deg, rgba(11, 13, 18, 0) 48%, rgba(11, 13, 18, 0.55) 78%, var(--bg) 100%),
      /* Reading side: page colour held flat across the text measure, then
         released. Listed first among the side washes so it only ever
         subtracts light. */
      linear-gradient(
        90deg,
        var(--bg) 0%,
        var(--bg) 36%,
        rgba(11, 13, 18, 0.9) 50%,
        rgba(11, 13, 18, 0.28) 70%,
        rgba(11, 13, 18, 0) 92%
      ),
      /* One cool field, wide enough to reach the right edge without a
         second centre. The dawn in the drawing is the only warm source. */
      radial-gradient(
        180% 120% at 72% 72%,
        rgba(24, 38, 56, 0.36) 0%,
        rgba(14, 22, 34, 0.14) 52%,
        rgba(11, 13, 18, 0) 88%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    /* Unchanged. The foot of the hero is no longer empty: the atmosphere above
       resolves to page colour across it, which is the transition into the
       work. */
    padding-block: clamp(3.5rem, 2.5rem + 6vw, 7.5rem) clamp(3rem, 2rem + 5vw, 6rem);
  }

  .hero__copy {
    max-width: 44rem;
  }

  .hero__name {
    margin-bottom: 0.9rem;
  }

  .hero__role {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    font-weight: 550;
    color: var(--cobalt-bright);
    letter-spacing: -0.008em;
  }

  /* The positioning line, treated as a brand statement rather than body copy.
     The measure is set so the sentence resolves to two balanced lines on every
     desktop and laptop width; three lines is a layout failure, so the grid
     below gives this column the room instead of trimming the type. */
  .hero__statement {
    margin-top: 1.5rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.62vw, 1.5rem);
    line-height: 1.38;
    letter-spacing: -0.014em;
    color: var(--text);
    max-width: 46ch;
    text-wrap: balance;
  }

  .hero__supporting {
    margin-top: 1.15rem;
    max-width: 58ch;
    color: var(--text-secondary);
  }

  .hero__location {
    margin-top: 1.15rem;
    font-size: var(--step-small);
    color: var(--text-tertiary);
  }

  /* Two sentences, one block. Each sits on its own line without adding
     spacing between them, and each still wraps normally on a narrow screen. */
  .hero__location span {
    display: block;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Decorative only. Below the two-column breakpoint it is a short band
     under the copy — a deliberate fragment of the horizon, not a shrink. */
  .hero__visual {
    position: relative;
    width: 100%;
    height: clamp(7rem, 28vw, 10rem);
    overflow: hidden;
    pointer-events: none;
  }

  .hero__dawn {
    position: absolute;
    top: 0;
    right: 0;
    width: min(100%, 34rem);
    height: auto;
    aspect-ratio: 7 / 5;
    /* Lifts the frame so the band opens on the sunrise and the limb. */
    transform: translateY(-34%);
    display: block;
    /* Band crop dissolves on all cut edges so the rectangle never reads. */
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 18%, #000 96%, transparent 100%),
      linear-gradient(180deg, transparent 8%, #000 28%, #000 78%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 18%, #000 96%, transparent 100%),
      linear-gradient(180deg, transparent 8%, #000 28%, #000 78%, transparent 100%);
    mask-composite: intersect;
    --dawn: 23s;
    --ease-dawn: linear;
  }

  /* Below the two-column layout the drawing is a shallow band, so the faintest
     outer haze and the widest lateral band have no room to read as atmosphere
     and only muddy the crop. They are pulled back rather than rescaled, which
     is what keeps the band a deliberate fragment instead of a shrunken
     desktop composition. */
  @media (max-width: 899px) {
    .hs-far {
      opacity: 0.55;
    }
  }

  /* Clears the sticky header when the hero link jumps here. Top padding matches
     Selected Work after its divider so both section breaks share one rhythm. */
  #speaking {
    scroll-margin-top: 5.5rem;
    padding-top: clamp(2.5rem, 2rem + 1.6vw, 3.25rem);
  }

  /* Two columns. The copy keeps the larger share at every width because the
     statement's line count outranks the size of the visual. */
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.55fr);
      align-items: center;
      gap: 2.75rem;
    }

    /* The track still reserves the right column, and therefore still fixes the
       width of the copy column, but it no longer carries a size the drawing
       has to respect: the drawing is taken out of flow below and positions
       against .hero instead. */
    .hero__visual {
      justify-self: end;
      width: min(100%, 17.5rem);
      height: auto;
      aspect-ratio: 8 / 5;
      position: static;
      overflow: visible;
    }

    /* One cinematic frame rather than a graphic box. It spans from a fixed
       offset right of the copy to a little past the window, so the horizon is
       cropped by the window rather than ending inside the page, and it grows
       with the window instead of with the column. Because it is absolutely
       positioned it contributes nothing to the grid, so the copy cannot move
       however large this gets. Both offsets are in rem, so the frame tracks
       the shell under zoom.

       An SVG is a replaced element, so the width has to be stated: with width
       auto the intrinsic size wins and the right offset is dropped. Because
       the shell is centred, the left offset and vw width are paired so the
       right edge always lands 1.5rem past the window. The width has to be in
       vw, not %, or it would resolve against the shell and stop growing once
       the shell hits its max. */
    .hero__dawn {
      top: 50%;
      left: calc(50% + 8.5rem);
      right: auto;
      width: calc(50vw - 7rem);
      max-width: none;
      height: auto;
      aspect-ratio: 7 / 5;
      transform: translateY(-50%);
      /* Left fade keeps the warm light off the copy. The right edge stays open
         so the dawn tail can reach the window instead of dying in a mask. */
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 100%);
    }
  }

  /* More room overall, so the field can take a little back. */
  @media (min-width: 1200px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.32fr) minmax(0, 0.68fr);
      gap: 4rem;
    }

    .hero__visual {
      width: min(100%, 23rem);
    }

    /* The copy column takes a smaller share above this width, so the frame
       starts further left and is correspondingly wider. The right edge still
       resolves to 100% + 1.5rem. */
    .hero__dawn {
      left: calc(50% + 5.5rem);
      width: calc(50vw - 4rem);
    }
  }

  /* The shell stops growing at 1264px, so from here on every extra pixel of
     window is clear space to the right of the copy. Only now can the frame
     take the aggressive offset: at 1200 that same offset would slide the cool
     horizon under the end of the supporting line, which costs contrast on the
     location copy for no compositional gain. */
  @media (min-width: 1360px) {
    .hero__dawn {
      left: calc(50% + 2rem);
      width: calc(50vw - 0.5rem);
    }
  }

  .hs-cool,
  .hs-haze,
  .hs-lift,
  .hs-veil,
  .hs-main,
  .hs-contact {
    transform-box: fill-box;
  }

  /* Fields are already full size. Only opacity changes, so a boundary
     never grows into view. */
  .hs-veil,
  .hs-main,
  .hs-haze,
  .hs-lift,
  .hs-contact {
    opacity: 0;
  }

  /* Opening frame. Near-black, faint cool separation, no warm light.
     Reduced motion overrides this to the finished dawn. */
  .hero__dawn[data-dawn='hold'] .hs-cool {
    opacity: 0.26;
  }

  /* 4s 17.4% · 7s 30.4% · 11s 47.8% · 16s 69.6% · 21s 91.3% · 23s 100%
     A point behind the horizon, then the field grows from that point.
     After 23s only the broad air drifts. The source stays put. */
  .hero__dawn[data-dawn='run'] .hs-cool {
    animation: hs-cool var(--dawn) var(--ease-dawn) forwards;
  }

  .hero__dawn[data-dawn='run'] .hs-contact {
    animation: hs-contact var(--dawn) var(--ease-dawn) forwards;
  }

  .hero__dawn[data-dawn='run'] .hs-veil {
    animation: hs-veil var(--dawn) var(--ease-dawn) forwards;
  }

  .hero__dawn[data-dawn='run'] .hs-main {
    animation: hs-main var(--dawn) var(--ease-dawn) forwards;
  }

  .hero__dawn[data-dawn='run'] .hs-haze {
    animation:
      hs-haze var(--dawn) var(--ease-dawn) forwards,
      hs-drift-haze 28s ease-in-out var(--dawn) infinite alternate;
  }

  .hero__dawn[data-dawn='run'] .hs-lift {
    animation:
      hs-lift var(--dawn) var(--ease-dawn) forwards,
      hs-drift-lift 32s ease-in-out var(--dawn) infinite alternate;
  }

  @keyframes hs-cool {
    0% { opacity: 0.26; }
    17.4% { opacity: 0.3; }
    30.4% { opacity: 0.36; }
    47.8% { opacity: 0.46; }
    69.6% { opacity: 0.58; }
    91.3% { opacity: 0.68; }
    100% { opacity: 0.72; }
  }

  @keyframes hs-contact {
    0% { opacity: 0; }
    17.4% { opacity: 0; }
    26% { opacity: 0.35; }
    30.4% { opacity: 0.85; }
    47.8% { opacity: 0.9; }
    69.6% { opacity: 0.95; }
    100% { opacity: 1; }
  }

  @keyframes hs-veil {
    0% { opacity: 0; }
    17.4% { opacity: 0; }
    26% { opacity: 0.35; }
    30.4% { opacity: 0.7; }
    47.8% { opacity: 1; }
    100% { opacity: 1; }
  }

  @keyframes hs-main {
    0% { opacity: 0; }
    30.4% { opacity: 0.08; }
    47.8% { opacity: 0.42; }
    69.6% { opacity: 0.72; }
    91.3% { opacity: 0.94; }
    100% { opacity: 1; }
  }

  @keyframes hs-haze {
    0% { opacity: 0; }
    30.4% { opacity: 0; }
    47.8% { opacity: 0.12; }
    69.6% { opacity: 0.5; }
    91.3% { opacity: 0.86; }
    100% { opacity: 1; }
  }

  @keyframes hs-lift {
    0% { opacity: 0; }
    47.8% { opacity: 0.1; }
