---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpeakingCard from '../components/SpeakingCard.astro';
import {
  person,
  links,
  projects,
  talksNewestFirst,
  about,
  previousWorkIntro,
  PERSON_ID,
} from '../data/site';
import { SITE_URL } from '../config/site.mjs';

const title = 'Frances Sun | Lead UX Designer & UX Speaker';
const description =
  'Frances Sun is a Lead UX Designer and UX speaker with experience across consumer electronics and enterprise software, specializing in complex workflows, systems thinking, interaction design, and hands-on prototyping.';

// The site itself, attributed to the one Person node defined in BaseLayout.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: person.name,
    url: `${SITE_URL}/`,
    inLanguage: 'en',
    publisher: { '@id': PERSON_ID },
    author: { '@id': PERSON_ID },
  },
];
---

<BaseLayout title={title} description={description} path="/" structuredData={structuredData}>
  <section class="hero">
    <div class="shell hero__inner">
      <div class="hero__copy">
        <h1 class="hero__name">{person.name}</h1>
        <p class="hero__role">{person.heroRole}</p>
        <p class="hero__statement">{person.statement}</p>
        <p class="hero__supporting">{person.supporting}</p>
        <p class="hero__location">
          <span>{person.location}</span>
          <span>{person.relocation}</span>
        </p>

        <div class="hero__actions">
          <a class="button button--primary" href="#work">View selected work</a>
          <a class="button button--ghost" href="#speaking">Invite me to speak</a>
        </div>
      </div>

      {/* Decorative. First light coming over the limb of a body far larger
          than the frame: one circle of radius 4800 against an 840 unit view,
          so only a 29 unit rise of its curvature is in shot and the horizon
          reads as almost a straight line. The light is built as layers of
          bloom rather than as a disc, and the whole sun group is drawn
          through a mask of the sky, so it is genuinely occluded by the body
          rather than faded in. Every gradient resolves to the page colour
          before it reaches an edge. Nothing here is focusable or announced. */}
      <div class="hero__visual" aria-hidden="true">
        <svg
          class="hero__dawn"
          data-dawn
          viewBox="-140 0 840 500"
          preserveAspectRatio="xMidYMid slice"
          focusable="false"
        >
          <defs>
            {/* Sky and body share one circle. Apex at x=220, y=358, which is
                72% down the frame, so the weight sits low and the space above
                stays open. */}
            <mask id="hs-sky" maskUnits="userSpaceOnUse" x="-200" y="-80" width="1100" height="660">
              <rect x="-200" y="-80" width="1100" height="660" fill="#fff" />
              <circle cx="220" cy="5158" r="4800" fill="#000" />
            </mask>
            <clipPath id="hs-body">
              <circle cx="220" cy="5158" r="4800" />
            </clipPath>

            {/* Depth layer one: space. A cool lift where the light is, wider
                than tall, so the frame reads as thin atmosphere rather than
                flat black. */}
            <radialGradient id="hs-void">
              <stop offset="0" stop-color="#1B2C44" stop-opacity="0.42" />
              <stop offset="0.4" stop-color="#141E2E" stop-opacity="0.2" />
              <stop offset="0.74" stop-color="#0b0d12" stop-opacity="0" />
            </radialGradient>

            {/* The star, built as light rather than as an object. The disc
                fades to nothing at its own edge, so there is no circular
                silhouette to read, and the white core over it blows the
                centre out the way an exposed camera would. */}
            <radialGradient id="hs-core">
              <stop offset="0" stop-color="#FFFFFF" />
              <stop offset="0.55" stop-color="#FFFFFF" stop-opacity="0.92" />
              <stop offset="1" stop-color="#FFF6DD" stop-opacity="0" />
            </radialGradient>
            {/* Pale gold inner bloom, wider than tall and drawn over the core
                so any residual edge is lost in its own light. */}
            <radialGradient id="hs-inner">
              <stop offset="0" stop-color="#FFF6DD" stop-opacity="0.78" />
              <stop offset="0.5" stop-color="#FFE5A6" stop-opacity="0.34" />
              <stop offset="1" stop-color="#FFD277" stop-opacity="0" />
            </radialGradient>
            {/* Amber survives only here, where the opacity is high enough that
                it still reads as gold rather than as tint. */}
            <radialGradient id="hs-mid">
              <stop offset="0" stop-color="#FFE5A6" stop-opacity="0.58" />
              <stop offset="0.42" stop-color="#E9AE4C" stop-opacity="0.22" />
              <stop offset="1" stop-color="#FFD277" stop-opacity="0" />
            </radialGradient>
            {/* Outer haze, as three offset masses at different sizes. No one
                of them is centred on the light, so the falloff is uneven and
                the result cannot read as a single radial gradient. */}
            {/* Amber is deliberately absent from the broad haze. At the very low
                opacities these bands run, #E9AE4C composited over the near-black
                page lands around hue 25 with the blue channel barely lifted,
                which renders as brown rather than atmosphere. Pale gold keeps
                the same warmth in the gold band once it is this dim. */}
            <radialGradient id="hs-corona">
              <stop offset="0" stop-color="#FFF6DD" stop-opacity="0.26" />
              <stop offset="0.5" stop-color="#FFE5A6" stop-opacity="0.11" />
              <stop offset="1" stop-color="#FFE5A6" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-corona-b">
              <stop offset="0" stop-color="#FFF6DD" stop-opacity="0.16" />
              <stop offset="0.55" stop-color="#FFE5A6" stop-opacity="0.065" />
              <stop offset="1" stop-color="#FFE5A6" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-corona-c">
              <stop offset="0" stop-color="#FFE5A6" stop-opacity="0.085" />
              <stop offset="0.6" stop-color="#FFE5A6" stop-opacity="0.032" />
              <stop offset="1" stop-color="#FFE5A6" stop-opacity="0" />
            </radialGradient>
            {/* One flat anamorphic spread through the star. Broad, faint and
                blurred, so it reads as glass and air, not a flare prop. */}
            <linearGradient id="hs-streak" gradientUnits="userSpaceOnUse" x1="-140" y1="0" x2="700" y2="0">
              <stop offset="0" stop-color="#FFD277" stop-opacity="0" />
              <stop offset="0.22" stop-color="#FFE5A6" stop-opacity="0.1" />
              <stop offset="0.31" stop-color="#FFF6DD" stop-opacity="0.3" />
              <stop offset="0.54" stop-color="#FFE5A6" stop-opacity="0.1" />
              <stop offset="1" stop-color="#FFD277" stop-opacity="0" />
            </linearGradient>
            {/* The horizontal spread, and the reason the sunrise reads big.
                Both are linear along x rather than radial, so the shape is a
                band of light across the horizon and never a round blob; the
                vertical softness comes only from the blur. Warm white at the
                centre, pale gold out, faint amber at the far edges, and the
                falloff is longer to the right than the left. */}
            <linearGradient id="hs-pool" gradientUnits="userSpaceOnUse" x1="-140" y1="0" x2="700" y2="0">
              <stop offset="0" stop-color="#E9AE4C" stop-opacity="0" />
              <stop offset="0.08" stop-color="#FFD277" stop-opacity="0.14" />
              <stop offset="0.18" stop-color="#FFE5A6" stop-opacity="0.34" />
              <stop offset="0.27" stop-color="#FFF6DD" stop-opacity="0.62" />
              <stop offset="0.31" stop-color="#FFF6DD" stop-opacity="0.94" />
              <stop offset="0.48" stop-color="#FFF6DD" stop-opacity="0.52" />
              <stop offset="0.66" stop-color="#FFE5A6" stop-opacity="0.2" />
              <stop offset="0.86" stop-color="#E9AE4C" stop-opacity="0.07" />
              <stop offset="1" stop-color="#E9AE4C" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hs-pool-wide" gradientUnits="userSpaceOnUse" x1="-140" y1="0" x2="700" y2="0">
              <stop offset="0" stop-color="#FFD277" stop-opacity="0" />
              <stop offset="0.12" stop-color="#FFE5A6" stop-opacity="0.12" />
              <stop offset="0.31" stop-color="#FFF6DD" stop-opacity="0.4" />
              <stop offset="0.62" stop-color="#FFE5A6" stop-opacity="0.14" />
              <stop offset="0.86" stop-color="#FFE5A6" stop-opacity="0.04" />
              <stop offset="1" stop-color="#FFD277" stop-opacity="0" />
            </linearGradient>

            {/* Depth layer three: the body in front. Offset 0 sits exactly on
                the limb apex. A faint cool lift there, page colour a little
                under it, then below the page colour deeper down, so the mass
                reads as a solid body in front of the sky rather than as more
                page. Without the darker foot the horizon is only a line. */}
            <linearGradient id="hs-planet" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0c1118" />
              <stop offset="0.0047" stop-color="#080a10" />
              <stop offset="0.0094" stop-color="#05070b" />
              {/* Back to page colour by y=495, five units above the bottom of
                  the frame. The darker foot has to resolve before the cut or
                  the crop shows as a horizontal step. */}
              <stop offset="0.0143" stop-color="#0b0d12" />
            </linearGradient>
            {/* Scattering carried just inside the limb, brightest under the
                star, which is what gives the body its curvature. */}
            <linearGradient id="hs-limb" gradientUnits="userSpaceOnUse" x1="-140" y1="0" x2="700" y2="0">
              <stop offset="0" stop-color="#31465F" stop-opacity="0.08" />
              <stop offset="0.16" stop-color="#31465F" stop-opacity="0.2" />
              <stop offset="0.31" stop-color="#7089A5" stop-opacity="0.28" />
              <stop offset="0.68" stop-color="#31465F" stop-opacity="0.14" />
              <stop offset="1" stop-color="#31465F" stop-opacity="0.04" />
            </linearGradient>
            {/* The rim: a desaturated blue grey edge that lifts towards the
                sunrise and drops away fast on either side, so the curve is
                never evenly lit. */}
            <linearGradient id="hs-rim" gradientUnits="userSpaceOnUse" x1="-140" y1="0" x2="700" y2="0">
              <stop offset="0" stop-color="#2A3340" stop-opacity="0.32" />
              <stop offset="0.12" stop-color="#3A4554" stop-opacity="0.4" />
              <stop offset="0.31" stop-color="#4A5564" stop-opacity="0.28" />
              <stop offset="0.64" stop-color="#3A4554" stop-opacity="0.16" />
              <stop offset="0.88" stop-color="#2A3340" stop-opacity="0.07" />
              <stop offset="1" stop-color="#2A3340" stop-opacity="0" />
            </linearGradient>
            {/* Depth layer two: haze sitting above the limb. */}
            <linearGradient id="hs-air" gradientUnits="userSpaceOnUse" x1="-140" y1="0" x2="700" y2="0">
              <stop offset="0" stop-color="#3A4554" stop-opacity="0.12" />
              <stop offset="0.14" stop-color="#3A4554" stop-opacity="0.2" />
              <stop offset="0.31" stop-color="#526C8B" stop-opacity="0.22" />
              <stop offset="0.66" stop-color="#3A4554" stop-opacity="0.14" />
              <stop offset="0.88" stop-color="#3A4554" stop-opacity="0.06" />
              <stop offset="1" stop-color="#3A4554" stop-opacity="0" />
            </linearGradient>
            {/* The limb's response to the star: cool, to pale blue white, to
                warm white, to pale gold exactly at the contact point, and
                back down to cool. Peaks at x=120, where the star sits. */}
            <linearGradient id="hs-sunline" gradientUnits="userSpaceOnUse" x1="-140" y1="0" x2="700" y2="0">
              <stop offset="0" stop-color="#526C8B" stop-opacity="0" />
              <stop offset="0.12" stop-color="#7089A5" stop-opacity="0.16" />
              <stop offset="0.2" stop-color="#7089A5" stop-opacity="0.4" />
              <stop offset="0.26" stop-color="#FFF6DD" stop-opacity="0.82" />
              <stop offset="0.31" stop-color="#FFF6DD" stop-opacity="1" />
              <stop offset="0.44" stop-color="#FFF6DD" stop-opacity="0.7" />
              <stop offset="0.58" stop-color="#7089A5" stop-opacity="0.26" />
              <stop offset="0.8" stop-color="#7089A5" stop-opacity="0.1" />
              <stop offset="1" stop-color="#526C8B" stop-opacity="0" />
            </linearGradient>

            {/* Filter regions are sized per shape. The flat ones need a very
                tall region or the blur is clipped into a hard band. */}
            <filter id="hs-f-soft" x="-25%" y="-25%" width="150%" height="150%">
              <feGaussianBlur stdDeviation="0.9" />
            </filter>
            <filter id="hs-f-core" x="-160%" y="-400%" width="420%" height="900%">
              <feGaussianBlur stdDeviation="7" />
            </filter>
            <filter id="hs-f-mid" x="-55%" y="-400%" width="210%" height="900%">
              <feGaussianBlur stdDeviation="6.5" />
            </filter>
            <filter id="hs-f-wide" x="-35%" y="-35%" width="170%" height="170%">
              <feGaussianBlur stdDeviation="9" />
            </filter>
            <filter id="hs-f-vast" x="-45%" y="-45%" width="190%" height="190%">
              <feGaussianBlur stdDeviation="13" />
            </filter>
            <filter id="hs-f-streak" x="-15%" y="-2400%" width="130%" height="4900%">
              <feGaussianBlur stdDeviation="5" />
            </filter>
            <filter id="hs-f-pool" x="-14%" y="-700%" width="128%" height="1500%">
              <feGaussianBlur stdDeviation="9" />
            </filter>
            <filter id="hs-f-pool-wide" x="-10%" y="-1400%" width="120%" height="2900%">
              <feGaussianBlur stdDeviation="7" />
            </filter>
            <filter id="hs-f-band" x="-12%" y="-280%" width="124%" height="660%">
              <feGaussianBlur stdDeviation="14" />
            </filter>
          </defs>

          {/* Depth one. Thin atmosphere, wider than tall. Static: it is the
              environment, not the event. */}
          <ellipse cx="80" cy="330" rx="620" ry="220" fill="url(#hs-void)" />

          {/* Everything the body can hide. */}
          <g mask="url(#hs-sky)">
            {/* Cool horizon shelf. Static environment, so the dim limb
                occupies the field left of the light instead of leaving a
                dead gap. */}
            <ellipse
              cx="-20"
              cy="357"
              rx="720"
              ry="7"
              fill="url(#hs-air)"
              filter="url(#hs-f-pool)"
              opacity="0.85" />

            {/* Outer atmosphere. Flat bands, none concentric, so the glow
                is a wide uneven wedge and never a dome. hs-haze-drift is
                the slow atmospheric shift; hs-swell only scales with the
                dawn, so the two transforms never fight. */}
            <g class="hs-swell">
              <g class="hs-haze-drift">
                <g class="hs-haze">
                  <ellipse
                    class="hs-light"
                    cx="140"
                    cy="340"
                    rx="580"
                    ry="40"
                    fill="url(#hs-corona)"
                    filter="url(#hs-f-band)" />
                  <ellipse
                    class="hs-light"
                    cx="70"
                    cy="318"
                    rx="520"
                    ry="44"
                    fill="url(#hs-corona-b)"
                    filter="url(#hs-f-band)" />
                  <g class="hs-far">
                    <ellipse
                      class="hs-light"
                      cx="190"
                      cy="292"
                      rx="420"
                      ry="42"
                      fill="url(#hs-corona-c)"
                      filter="url(#hs-f-band)" />
                    <ellipse
                      class="hs-light"
                      cx="20"
                      cy="268"
                      rx="340"
                      ry="38"
                      fill="url(#hs-corona-c)"
                      filter="url(#hs-f-band)" />
                  </g>
                </g>
              </g>
            </g>

            {/* Mid bloom sits on the limb and does not rise. It is atmosphere
                leaking, not a solar body. */}
            <ellipse class="hs-light" cx="120" cy="356" rx="480" ry="30" fill="url(#hs-mid)" />

            {/* The only thing that rises. A flat overexposed core, already
                half behind the limb, with pale bloom drawn over it so no
                circumference can read. */}
            <g class="hs-sun">
              <ellipse class="hs-core" cx="120" cy="356" rx="220" ry="18" fill="url(#hs-inner)" filter="url(#hs-f-mid)" />
              <ellipse class="hs-core" cx="120" cy="357" rx="110" ry="5" fill="url(#hs-core)" filter="url(#hs-f-core)" />
            </g>

            {/* Horizontal light, the scale of the scene. hs-spread widens
                through the dawn; hs-spread-drift is the living shift. */}
            <g class="hs-spread">
              <g class="hs-spread-drift">
                <ellipse
                  class="hs-ember"
                  cx="130"
                  cy="352"
                  rx="600"
                  ry="22"
                  fill="url(#hs-pool-wide)"
                  filter="url(#hs-f-band)" />
                <ellipse
                  class="hs-ember"
                  cx="120"
                  cy="358"
                  rx="520"
                  ry="14"
                  fill="url(#hs-pool)"
                  filter="url(#hs-f-pool)" />
                <ellipse
                  class="hs-shimmer"
                  cx="120"
                  cy="357"
                  rx="300"
                  ry="3"
                  fill="url(#hs-streak)"
                  filter="url(#hs-f-streak)" />
                <g class="hs-far">
                  <ellipse
                    class="hs-ember"
                    cx="160"
                    cy="360"
                    rx="700"
                    ry="5"
                    fill="url(#hs-pool-wide)"
                    filter="url(#hs-f-pool-wide)" />
                </g>
              </g>
            </g>
          </g>

          {/* Depth three. The body, in front of the light. */}
          <circle cx="220" cy="5158" r="4800" fill="url(#hs-planet)" />

          {/* Scattering on the body. A stroke on the limb, clipped to the
              silhouette, so the band follows the curve instead of floating
              as a shape of its own. */}
          <g clip-path="url(#hs-body)">
            <circle
              cx="220"
              cy="5158"
              r="4800"
              fill="none"
              stroke="url(#hs-limb)"
              stroke-width="46"
              filter="url(#hs-f-vast)"></circle>
          </g>

          {/* Depth two. Haze above the limb: a wide cool scatter, a tighter
              band, then the star's own contribution near the contact point.
              Each stroke is centred on the limb, so the mask keeps only the
              half that belongs to the sky. */}
          <g mask="url(#hs-sky)">
            <circle
              cx="220"
              cy="5158"
              r="4800"
              fill="none"
              stroke="url(#hs-air)"
              stroke-width="22"
              stroke-opacity="0.28"
              filter="url(#hs-f-vast)"></circle>
            <circle
              cx="220"
              cy="5158"
              r="4800"
              fill="none"
              stroke="url(#hs-air)"
              stroke-width="7"
              stroke-opacity="0.55"
              filter="url(#hs-f-mid)"></circle>
            <circle
              class="hs-ember"
              cx="220"
              cy="5158"
              r="4800"
              fill="none"
              stroke="url(#hs-sunline)"
              stroke-width="22"
              stroke-opacity="0.66"
              filter="url(#hs-f-wide)"></circle>
          </g>

          {/* The limb itself. One hairline. The cool edge is kept thin and
              dim so it cannot read as Earth's atmosphere from orbit, which
              is the stock-space look this drawing has to refuse. */}
          <circle
            cx="220"
            cy="5158"
            r="4800"
            fill="none"
            stroke="url(#hs-rim)"
            stroke-width="1.2"
            stroke-opacity="0.7"></circle>
          <circle
            class="hs-ember"
            cx="220"
            cy="5158"
            r="4800"
            fill="none"
            stroke="url(#hs-sunline)"
            stroke-width="1.6"
            filter="url(#hs-f-soft)"></circle>
        </svg>
      </div>
    </div>
  </section>

  {/* Plays the sunrise on load and again whenever the hero comes back into
      view. Inline and immediately after the drawing, so the armed frame is
      set before the first paint. Without it the scene rests, composed, in
      its finished frame. */}
  <script is:inline>
    (() => {
      const scene = document.querySelector('[data-dawn]');
      if (!scene || !('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const hero = scene.closest('.hero') || scene;
      scene.dataset.dawn = 'hold';
      let armed = true;

      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            // Rearm only once the hero has left completely. The 17s sequence
            // must not restart from casual scroll jitter at the threshold.
            if (entry.intersectionRatio === 0) {
              armed = true;
            } else if (armed && entry.intersectionRatio >= 0.25) {
              armed = false;
              scene.dataset.dawn = 'hold';
              void scene.getBoundingClientRect();
              scene.dataset.dawn = 'run';
            }
          }
        },
        { threshold: [0, 0.25] },
      ).observe(hero);
    })();
  </script>

  <hr class="divider" />

  <section class="section" id="work" aria-labelledby="work-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="work-heading">Selected Work</h2>
        <p>
          Product design across consumer electronics, enterprise software, and complex operational
          workflows.
        </p>
      </header>

      <div class="work-grid">
        {projects.map((project, index) => <ProjectCard project={project} priority={index === 0} />)}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="speaking" aria-labelledby="speaking-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="speaking-heading">Speaking</h2>
        <p>
          Conference and university talks on enterprise UX, systems thinking, product clarity, and
          creative problem solving.
        </p>
      </header>

      <div class="speaking-grid">
        {/* The grid is two up, so it shows the two most recent talks rather
            than leaving a third stranded on its own row. The rest are one
            click away. */}
        {talksNewestFirst.slice(0, 2).map((talk) => <SpeakingCard talk={talk} />)}
      </div>

      <p class="speaking-more">
        <a class="text-link" href="/speaking">View talks <span aria-hidden="true">→</span></a>
      </p>
      <div class="speaking-inquiry">
        <p>For conference, university, and UX community speaking inquiries.</p>
        <p>
          <a class="text-link" href="mailto:francessun@gmail.com?subject=Speaking%20Inquiry%20for%20Frances%20Sun">
            Speaking inquiry <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section section--tight" id="previous-work" aria-labelledby="previous-heading">
    <div class="shell previous">
      <h2 id="previous-heading" class="previous__heading">Previous Work</h2>
      <div class="previous__body">
        <p class="previous__copy">{previousWorkIntro.copy}</p>
        <p>
          <a class="text-link" href={previousWorkIntro.href}>
            {previousWorkIntro.cta} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="shell about">
      <h2 id="about-heading">About</h2>
      <div class="about__body">
        <p class="lede">{about.homepage}</p>
        <p class="about__links">
          <a class="text-link" href="/about">More about Frances <span aria-hidden="true">→</span></a>
          <a class="text-link" href={links.resume} target="_blank" rel="noopener">
            Resume <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    /* Symmetric in and out, so the light has no discernible start or end. */
    --ease-breathe: cubic-bezier(0.45, 0, 0.55, 1);
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: 2rem;
