---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpeakingCard from '../components/SpeakingCard.astro';
import {
  person,
  links,
  projects,
  talksNewestFirst,
  about,
  previousWorkIntro,
  PERSON_ID,
} from '../data/site';
import { SITE_URL } from '../config/site.mjs';

const title = 'Frances Sun | Lead UX Designer & UX Speaker';
const description =
  'Frances Sun is a Lead UX Designer and UX speaker with experience across consumer electronics and enterprise software, specializing in complex workflows, systems thinking, interaction design, and hands-on prototyping.';

// The site itself, attributed to the one Person node defined in BaseLayout.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: person.name,
    url: `${SITE_URL}/`,
    inLanguage: 'en',
    publisher: { '@id': PERSON_ID },
    author: { '@id': PERSON_ID },
  },
];
---

<BaseLayout title={title} description={description} path="/" structuredData={structuredData}>
  <section class="hero">
    <div class="shell hero__inner">
      <div class="hero__copy">
        <h1 class="hero__name">{person.name}</h1>
        <p class="hero__role">{person.heroRole}</p>
        <p class="hero__statement">{person.statement}</p>
        <p class="hero__supporting">{person.supporting}</p>
        <p class="hero__location">
          <span>{person.location}</span>
          <span>{person.relocation}</span>
        </p>

        <div class="hero__actions">
          <a class="button button--primary" href="#work">View selected work</a>
          <a class="button button--ghost" href="#speaking">Invite me to speak</a>
        </div>
      </div>

      {/* Decorative. A sunrise over the edge of a very large planet. The
          planet is one ellipse, mostly off-canvas. The sun and its light are
          drawn through a mask of the sky, so they pass behind the horizon
          as they rise. Nothing here is focusable or announced. */}
      <div class="hero__visual" aria-hidden="true">
        <svg
          class="hero__dawn"
          viewBox="0 0 400 400"
          preserveAspectRatio="xMidYMid slice"
          focusable="false"
        >
          <defs>
            {/* Sky: everything above the planet. */}
            <mask id="hs-sky" maskUnits="userSpaceOnUse" x="0" y="0" width="400" height="400">
              <rect width="400" height="400" fill="#fff" />
              <ellipse cx="215" cy="432" rx="540" ry="220" fill="#000" />
            </mask>

            {/* The disc: a warm white core that cools to gold at a soft,
                translucent edge. No offset highlight, so no sphere. */}
            <radialGradient id="hs-disc">
              <stop offset="0" stop-color="#FFF9E6" />
              <stop offset="0.5" stop-color="#FFEDB8" />
              <stop offset="0.82" stop-color="#FFD97E" stop-opacity="0.95" />
              <stop offset="1" stop-color="#FFC966" stop-opacity="0.45" />
            </radialGradient>
            <radialGradient id="hs-edge">
              <stop offset="0.6" stop-color="#FFD978" stop-opacity="0.5" />
              <stop offset="1" stop-color="#FFC45E" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-glow">
              <stop offset="0" stop-color="#FFEBB4" stop-opacity="0.6" />
              <stop offset="0.4" stop-color="#FFC966" stop-opacity="0.2" />
              <stop offset="1" stop-color="#F6AD45" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-bloom">
              <stop offset="0" stop-color="#F8B84E" stop-opacity="0.3" />
              <stop offset="0.5" stop-color="#F6AD45" stop-opacity="0.09" />
              <stop offset="1" stop-color="#F6AD45" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-haze">
              <stop offset="0" stop-color="#FFD978" stop-opacity="0.15" />
              <stop offset="0.55" stop-color="#F6AD45" stop-opacity="0.04" />
              <stop offset="1" stop-color="#F6AD45" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="hs-spread">
              <stop offset="0" stop-color="#FFF0BB" stop-opacity="0.34" />
              <stop offset="0.5" stop-color="#FFD978" stop-opacity="0.1" />
              <stop offset="1" stop-color="#FFD978" stop-opacity="0" />
            </radialGradient>
            {/* Planet body. Page colour almost at once, so the box that
                clips this drawing never shows. Only a whisper of darkness
                sits right under the rim. */}
            <linearGradient id="hs-planet" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#07090d" />
              <stop offset="0.09" stop-color="#0b0d12" />
            </linearGradient>
            <linearGradient id="hs-rim" gradientUnits="userSpaceOnUse" x1="-10" y1="0" x2="420" y2="0">
              <stop offset="0" stop-color="#31465F" stop-opacity="0" />
              <stop offset="0.14" stop-color="#526C8B" stop-opacity="0.45" />
              <stop offset="0.6" stop-color="#7EA4C7" stop-opacity="0.7" />
              <stop offset="0.9" stop-color="#526C8B" stop-opacity="0.4" />
              <stop offset="1" stop-color="#31465F" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hs-air" gradientUnits="userSpaceOnUse" x1="-10" y1="0" x2="420" y2="0">
              <stop offset="0" stop-color="#526C8B" stop-opacity="0" />
              <stop offset="0.18" stop-color="#526C8B" stop-opacity="0.3" />
              <stop offset="0.6" stop-color="#7EA4C7" stop-opacity="0.34" />
              <stop offset="0.88" stop-color="#526C8B" stop-opacity="0.26" />
              <stop offset="1" stop-color="#526C8B" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hs-sunline" gradientUnits="userSpaceOnUse" x1="128" y1="0" x2="368" y2="0">
              <stop offset="0" stop-color="#FFC45E" stop-opacity="0" />
              <stop offset="0.36" stop-color="#FFD978" stop-opacity="0.65" />
              <stop offset="0.5" stop-color="#FFF0BB" stop-opacity="1" />
              <stop offset="0.64" stop-color="#FFD978" stop-opacity="0.65" />
              <stop offset="1" stop-color="#FFC45E" stop-opacity="0" />
            </linearGradient>

            <filter id="hs-soft" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation="0.9" />
            </filter>
            <filter id="hs-disc-soft" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="1.7" />
            </filter>
            <filter id="hs-blur" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation="2.4" />
            </filter>
            <filter id="hs-wide" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur stdDeviation="5.5" />
            </filter>
          </defs>

          {/* Sky light, occluded by the planet. */}
          <g mask="url(#hs-sky)">
            <g class="hs-haze">
              <ellipse cx="248" cy="192" rx="200" ry="122" fill="url(#hs-haze)" />
            </g>
            <g class="hs-spread">
              <ellipse cx="248" cy="212" rx="150" ry="8" fill="url(#hs-spread)" filter="url(#hs-blur)" />
            </g>
            <g class="hs-sun">
              <ellipse class="hs-light" cx="248" cy="178" rx="126" ry="86" fill="url(#hs-bloom)" />
              <ellipse class="hs-light" cx="248" cy="178" rx="76" ry="60" fill="url(#hs-glow)" />
              <circle cx="248" cy="176" r="42" fill="url(#hs-edge)" filter="url(#hs-blur)" />
              <circle cx="248" cy="176" r="28" fill="url(#hs-disc)" filter="url(#hs-disc-soft)" />
            </g>
          </g>

          {/* The planet. */}
          <ellipse cx="215" cy="432" rx="540" ry="220" fill="url(#hs-planet)" />

          {/* Atmosphere above the rim, and the sunlight on it. */}
          <g mask="url(#hs-sky)">
            <ellipse
              cx="215"
              cy="432"
              rx="540"
              ry="220"
              fill="none"
              stroke="url(#hs-air)"
              stroke-width="6"
              filter="url(#hs-blur)"></ellipse>
            <ellipse
              class="hs-light"
              cx="215"
              cy="432"
              rx="540"
              ry="220"
              fill="none"
              stroke="url(#hs-sunline)"
              stroke-width="10"
              stroke-opacity="0.45"
              filter="url(#hs-wide)"></ellipse>
          </g>
          <ellipse
            cx="215"
            cy="432"
            rx="542"
            ry="224"
            fill="none"
            stroke="url(#hs-rim)"
            stroke-width="0.6"
            stroke-opacity="0.2"></ellipse>
          <ellipse cx="215" cy="432" rx="540" ry="220" fill="none" stroke="url(#hs-rim)" stroke-width="1"></ellipse>
          <ellipse
            class="hs-light"
            cx="215"
            cy="432"
            rx="540"
            ry="220"
            fill="none"
            stroke="url(#hs-sunline)"
            stroke-width="1.4"
            filter="url(#hs-soft)"></ellipse>
        </svg>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="work" aria-labelledby="work-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="work-heading">Selected Work</h2>
        <p>
          Product design across consumer electronics, enterprise software, and complex operational
          workflows.
        </p>
      </header>

      <div class="work-grid">
        {projects.map((project, index) => <ProjectCard project={project} priority={index === 0} />)}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="speaking" aria-labelledby="speaking-heading">
    <div class="shell">
      <header class="section-intro">
        <h2 id="speaking-heading">Speaking</h2>
        <p>
          Conference and university talks on enterprise UX, systems thinking, product clarity, and
          creative problem solving.
        </p>
      </header>

      <div class="speaking-grid">
        {/* The grid is two up, so it shows the two most recent talks rather
            than leaving a third stranded on its own row. The rest are one
            click away. */}
        {talksNewestFirst.slice(0, 2).map((talk) => <SpeakingCard talk={talk} />)}
      </div>

      <p class="speaking-more">
        <a class="text-link" href="/speaking">View talks <span aria-hidden="true">→</span></a>
      </p>
      <div class="speaking-inquiry">
        <p>For conference, university, and UX community speaking inquiries.</p>
        <p>
          <a class="text-link" href="mailto:francessun@gmail.com?subject=Speaking%20Inquiry%20for%20Frances%20Sun">
            Speaking inquiry <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section section--tight" id="previous-work" aria-labelledby="previous-heading">
    <div class="shell previous">
      <h2 id="previous-heading" class="previous__heading">Previous Work</h2>
      <div class="previous__body">
        <p class="previous__copy">{previousWorkIntro.copy}</p>
        <p>
          <a class="text-link" href={previousWorkIntro.href}>
            {previousWorkIntro.cta} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="shell about">
      <h2 id="about-heading">About</h2>
      <div class="about__body">
        <p class="lede">{about.homepage}</p>
        <p class="about__links">
          <a class="text-link" href="/about">More about Frances <span aria-hidden="true">→</span></a>
          <a class="text-link" href={links.resume} target="_blank" rel="noopener">
            Resume <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    /* Symmetric in and out, so the light has no discernible start or end. */
    --ease-breathe: cubic-bezier(0.45, 0, 0.55, 1);
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: 2rem;
    padding-block: clamp(3.5rem, 2.5rem + 6vw, 7.5rem) clamp(3rem, 2rem + 5vw, 6rem);
  }

  .hero__copy {
    max-width: 44rem;
  }

  .hero__name {
    margin-bottom: 0.9rem;
  }

  .hero__role {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    font-weight: 550;
    color: var(--cobalt-bright);
    letter-spacing: -0.008em;
  }

  /* The positioning line, treated as a brand statement rather than body copy.
     The measure is set so the sentence resolves to two balanced lines on every
     desktop and laptop width; three lines is a layout failure, so the grid
     below gives this column the room instead of trimming the type. */
  .hero__statement {
    margin-top: 1.5rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.62vw, 1.5rem);
    line-height: 1.38;
    letter-spacing: -0.014em;
    color: var(--text);
    max-width: 46ch;
    text-wrap: balance;
  }

  .hero__supporting {
    margin-top: 1.15rem;
    max-width: 58ch;
    color: var(--text-secondary);
  }

  .hero__location {
    margin-top: 1.15rem;
    font-size: var(--step-small);
    color: var(--text-tertiary);
  }

  /* Two sentences, one block. Each sits on its own line without adding
     spacing between them, and each still wraps normally on a narrow screen. */
  .hero__location span {
    display: block;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Decorative only. Below the two-column breakpoint it is a short band
     under the copy. The drawing keeps its own square size inside the band,
     right-aligned and cropped top and bottom, so it stays a small fragment
     rather than scaling to the page width. */
  .hero__visual {
    position: relative;
    width: 100%;
    height: clamp(6rem, 24vw, 9rem);
    overflow: hidden;
  }

  .hero__dawn {
    position: absolute;
    top: 0;
    right: 0;
    width: min(64%, 28rem);
    height: auto;
    aspect-ratio: 1 / 1;
    /* Lifts the square so the band opens on sky, then sun, then rim. */
    transform: translateY(-25%);
    display: block;
    /* The band crops the square, so the cut left and top edges fade out. */
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 34%),
      linear-gradient(180deg, transparent 25%, #000 37%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 34%),
      linear-gradient(180deg, transparent 25%, #000 37%);
    mask-composite: intersect;
    /* Slow start, a little momentum, long settle. */
    --ease-rise: cubic-bezier(0.4, 0.02, 0.12, 1);
  }

  /* Clears the sticky header when the hero link jumps here. Resting
     spacing of the section is unchanged. */
  #speaking {
    scroll-margin-top: 5.5rem;
  }

  /* Two columns. The copy keeps the larger share at every width because the
     statement's line count outranks the size of the visual. */
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.55fr);
      align-items: center;
      gap: 2.75rem;
    }

    .hero__visual {
      justify-self: end;
      width: min(100%, 17.5rem);
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .hero__dawn {
      top: 0;
      right: auto;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      transform: none;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* More room overall, so the field can take a little back. */
  @media (min-width: 1200px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.32fr) minmax(0, 0.68fr);
      gap: 4rem;
    }

    .hero__visual {
      width: min(100%, 22rem);
    }
  }

  /* The sun starts 58 user units lower, which leaves a 6 unit crescent
     (about 10% of the 56 unit disc) above the horizon, and rises once. The
     declared values below are the finished frame, so a reduced-motion
     visitor gets the ending with no animation at all. Only transform and
     opacity move. The blurs are static. */
  .hs-sun {
    transform: translateY(0);
    animation: hs-rise 4s var(--ease-rise) both;
  }

  .hs-light {
    opacity: 1;
    animation: hs-light 4s var(--ease-rise) both;
  }

  /* After the rise, the outer haze and the low horizontal spread keep a
     faint 12 second breath. The sun itself never moves again. */
  .hs-haze,
  .hs-spread {
    transform-box: fill-box;
    transform-origin: center;
  }

  .hs-haze {
    animation: hs-breathe 12s var(--ease-breathe) 4s infinite;
  }

  .hs-spread {
    animation: hs-drift 12s var(--ease-breathe) 4s infinite;
  }

  @keyframes hs-rise {
    from {
      transform: translateY(58px);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes hs-light {
    from {
      opacity: 0.2;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hs-breathe {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.93;
      transform: scale(1.012);
    }
  }

  @keyframes hs-drift {
    0%,
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
    50% {
      opacity: 0.94;
      transform: scaleX(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs-sun,
    .hs-light,
    .hs-haze,
    .hs-spread {
      animation: none;
    }
  }

  /* ---------- Sections ---------- */

  /* Title and subtitle read as one unit. The subtitle stays under the
     heading at every width, never in a second column. */
  .section-intro {
    margin-bottom: clamp(1.75rem, 1.2rem + 2vw, 3rem);
  }

  .section-intro p {
    margin: 0.6rem 0 0;
    max-width: 42rem;
    font-size: var(--step-small);
    color: var(--text-secondary);
  }

  .work-grid,
  .speaking-grid {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  @media (min-width: 900px) {
    .work-grid,
    .speaking-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .speaking-more {
    margin-top: 1.35rem;
  }

  .speaking-inquiry {
    margin-top: clamp(2.5rem, 2rem + 1.5vw, 3.25rem);
  }

  .speaking-inquiry p {
    margin: 0;
  }

  .speaking-inquiry p:first-child {
    max-width: 42rem;
    font-size: var(--step-small);
    color: var(--text-tertiary);
  }

  .speaking-inquiry p + p {
    margin-top: 0.55rem;
  }

  /* ---------- Previous work: deliberately quieter ---------- */

  .previous {
    display: grid;
    gap: 1rem;
  }

  .previous__heading {
    font-size: clamp(1.375rem, 1.25rem + 0.6vw, 1.75rem);
  }

  .previous__body {
    display: grid;
    gap: 0.9rem;
  }

  .previous__copy {
    max-width: none;
    font-size: var(--step-small);
    color: var(--text-secondary);
  }

  @media (min-width: 900px) {
    .previous {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }

  /* ---------- About ---------- */

  .about {
    display: grid;
    gap: 1.25rem;
  }

  .about__body {
    display: grid;
    gap: 1.5rem;
    max-width: 68ch;
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }
</style>
