---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PresentationViewer from '../../components/PresentationViewer.astro';
import { talks, PERSON_ID, type Talk } from '../../data/site';
import { loadDeck } from '../../lib/slides';

export function getStaticPaths() {
  return talks.map((talk) => ({ params: { slug: talk.slug }, props: { talk } }));
}

const { talk } = Astro.props;
const slides = loadDeck(talk.deck);

/**
 * Eyebrow only when an organisation line adds context the event name does not
 * already carry. Otherwise the Event meta field is enough — repeating
 * "CanUX 2025" as both eyebrow and Event teaches nothing.
 */
function talkEyebrow(entry: Talk): string | null {
  const org = entry.organization?.at(-1);
  if (!org) return null;
  return `${org} · ${entry.event}`;
}

/** Standalone YEAR only when the event name does not already state it. */
const showYearMeta = !talk.event.includes(talk.year);
const eyebrow = talkEyebrow(talk);

const site = Astro.site ?? new URL('http://localhost:4321');
const talkUrl = new URL(`/speaking/${talk.slug}`, site).href;

// A date is included only when one was actually recorded.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'PresentationDigitalDocument',
    name: talk.title,
    headline: talk.title,
    description: talk.intro,
    url: talkUrl,
    inLanguage: 'en',
    copyrightYear: talk.year,
    ...(talk.date ? { datePublished: talk.date } : {}),
    numberOfPages: slides.length || undefined,
    image: new URL(talk.image, site).href,
    // Reference the site-wide Person node rather than minting a new,
    // unidentified one for every talk.
    author: { '@id': PERSON_ID },
    about: [
      'Enterprise UX',
      'Enterprise product design',
      'Systems thinking',
      'Complex workflow design',
      'Design systems',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Speaking', item: new URL('/speaking', site).href },
      { '@type': 'ListItem', position: 3, name: talk.title, item: talkUrl },
    ],
  },
];
---

<BaseLayout
  title={talk.seoTitle}
  description={talk.seoDescription}
  path={`/speaking/${talk.slug}`}
  ogImage={talk.image}
  ogImageAlt={talk.imageAlt}
  ogType="article"
  structuredData={structuredData}
>
  <article class="talk">
    <div class="shell">
      <p class="talk__back">
        <a class="text-link" href="/speaking">
          <span aria-hidden="true">←</span> Back to Speaking
        </a>
      </p>

      <div class="talk__head">
        <div class="talk__intro">
          {eyebrow && <p class="eyebrow talk__eyebrow">{eyebrow}</p>}
          <h1>{talk.title}</h1>
          <p class="lede talk__lede">{talk.intro}</p>
          {talk.supporting && <p class="talk__supporting">{talk.supporting}</p>}

          <dl class="talk__meta">
            <div>
              <dt>Event</dt>
              <dd>
                {talk.event}
                {talk.organization?.map((line) => <span class="talk__meta-line">{line}</span>)}
              </dd>
            </div>
            {
              talk.series && (
                <div>
                  <dt>Series</dt>
                  <dd>{talk.series}</dd>
                </div>
              )
            }
            {
              talk.venue && (
                <div>
                  <dt>Venue</dt>
                  <dd>{talk.venue}</dd>
                </div>
              )
            }
            <div>
              <dt>Location</dt>
              <dd>{talk.location}</dd>
            </div>
            {
              talk.dateLabel && (
                <div>
                  <dt>Date</dt>
                  <dd>{talk.dateLabel}</dd>
                </div>
              )
            }
            {
              showYearMeta && (
                <div>
                  <dt>Year</dt>
                  <dd>{talk.year}</dd>
                </div>
              )
            }
          </dl>
        </div>

        <figure class="talk__figure">
          <img
            src={talk.image}
            alt={talk.imageAlt}
            width={talk.imageWidth ?? 1600}
            height={talk.imageHeight ?? 1000}
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </div>

    <section class="section section--tight" aria-labelledby="browse-heading">
      <div class="shell">
        <h2 id="browse-heading">Browse the talk</h2>
        <p class="talk__browse-note">
          The full deck, one slide at a time. Use the arrows, your keyboard, or the thumbnails
          below. Nothing advances on its own.
        </p>

        <PresentationViewer slides={slides} deck={talk.deck} talkTitle={talk.title} />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .talk__back {
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .talk__head {
    display: grid;
    gap: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
    padding-block: clamp(1.75rem, 1.2rem + 2.5vw, 3rem) 0;
  }

  /* Modest separation so the eyebrow reads as context, not a stuck label. */
  .talk__eyebrow {
    margin: 0 0 1rem;
  }

  .talk__intro h1 {
    margin-bottom: 1.15rem;
  }

  .talk__lede {
    max-width: 62ch;
  }

  .talk__supporting {
    max-width: 62ch;
    margin-top: 1rem;
    font-size: var(--step-small);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Compact: Event + Location only on current talks. No empty slots left by
     removed Year / Slides fields. */
  .talk__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, max-content));
    gap: 1.15rem 2.75rem;
    margin: 1.75rem 0 0;
  }

  .talk__meta dt {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .talk__meta dd {
    margin: 0.3rem 0 0;
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--text);
  }

  .talk__meta-line {
    display: block;
    color: var(--text-secondary);
  }

  .talk__figure {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #05070a;
  }

  .talk__figure img {
    width: 100%;
    height: auto;
  }

  .talk__browse-note {
    max-width: 58ch;
    margin-top: 0.85rem;
    font-size: var(--step-small);
    color: var(--text-tertiary);
  }

  @media (min-width: 1024px) {
    .talk__head {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: start;
    }

    .talk__figure {
      position: sticky;
      top: 6rem;
    }
  }
</style>
