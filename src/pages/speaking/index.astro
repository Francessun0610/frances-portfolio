---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpeakingCard from '../../components/SpeakingCard.astro';
import { links, talksNewestFirst } from '../../data/site';

const title = 'Enterprise UX Speaker | Frances Sun';
const description =
  'Conference and university talks by Frances Sun on enterprise UX, systems thinking, product clarity, complex workflows, and creativity in design.';
---

<BaseLayout title={title} description={description} path="/speaking">
  <section class="speaking-index">
    <div class="shell">
      <header class="speaking-index__head">
        <p class="eyebrow">Speaking</p>
        <h1>Speaking</h1>
        <p class="lede measure">
          I speak about enterprise UX, domain complexity, systems thinking, and the practical work
          of making complicated products easier to understand and use.
        </p>
        <p class="measure speaking-index__note">
          My talks draw from hands-on experience designing enterprise software, operational
          workflows, and connected product ecosystems.
        </p>
        <p class="measure speaking-index__invite">
          For conference, university, and UX community speaking inquiries, get in touch.
        </p>
        <p class="speaking-index__invite-action">
          <a class="button button--ghost" href={links.linkedin} target="_blank" rel="noopener noreferrer">
            Invite me to speak <span aria-hidden="true">↗</span>
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </p>
      </header>

      <div class="speaking-index__grid">
        {
          talksNewestFirst.map((talk, index) => (
            <SpeakingCard talk={talk} priority={index === 0} headingLevel={2} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .speaking-index {
    padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .speaking-index__head {
    margin-bottom: clamp(2rem, 1.25rem + 1.5vw, 3rem);
  }

  .speaking-index__head h1 {
    margin-bottom: 1.25rem;
  }

  /* Wider than the shared 58ch measure, and never past the card grid,
     which is this same shell. The opening line stops at 52rem so it breaks
     into two real lines instead of a full line and a short tail. */
  .speaking-index__head .lede {
    max-width: min(52rem, 100%);
  }

  .speaking-index__head .speaking-index__note,
  .speaking-index__head .speaking-index__invite {
    max-width: 100%;
  }

  /* Just below the width where the second sentence fits on one line, a full
     container leaves a few words alone. Pull it in so the wrap stays even. */
  @media (max-width: 1150px) {
    .speaking-index__head .speaking-index__note {
      max-width: 38rem;
    }
  }

  /* Second intro line sits a step quieter than the lede. */
  .speaking-index__note {
    margin-top: 0.85rem;
    color: var(--text-secondary);
  }

  .speaking-index__invite {
    margin-top: 1.5rem;
    color: var(--text-secondary);
  }

  .speaking-index__invite-action {
    margin-top: 1rem;
  }

  .speaking-index__grid {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  @media (min-width: 900px) {
    .speaking-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
