---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpeakingCard from '../../components/SpeakingCard.astro';
import { links, talksNewestFirst } from '../../data/site';

const title = 'Frances Sun | Enterprise UX Speaker & Educator';
const description =
  'Explore Frances Sun’s conference and university talks on enterprise UX, systems thinking, workflow clarity, and creativity in design.';
---

<BaseLayout title={title} description={description} path="/speaking">
  <section class="speaking-index">
    <div class="shell">
      <header class="speaking-index__head">
        <h1>Speaking</h1>
        <p class="lede">
          I speak about enterprise UX, systems thinking, and making complex products easier to
          understand.
        </p>
        <p class="speaking-index__note">
          My talks draw on hands-on product design, team leadership, and teaching.
        </p>
        <p class="speaking-index__invite-action">
          <a class="button button--ghost" href={links.linkedin} target="_blank" rel="noopener noreferrer">
            Invite me to speak <span aria-hidden="true">↗</span>
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </p>
      </header>

      <div class="speaking-index__grid">
        {
          talksNewestFirst.map((talk, index) => (
            <SpeakingCard talk={talk} priority={index === 0} headingLevel={2} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .speaking-index {
    padding-top: 36px;
    padding-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  @media (min-width: 900px) {
    .speaking-index {
      padding-top: 60px;
    }
  }

  .speaking-index__head {
    margin-bottom: 40px;
  }

  .speaking-index__head h1 {
    margin-bottom: 24px;
  }

  .speaking-index__head .lede,
  .speaking-index__note {
    max-width: none;
    margin: 0;
  }

  .speaking-index__note {
    margin-top: 12px;
    color: var(--text-secondary);
  }

  .speaking-index__invite-action {
    margin-top: 24px;
  }

  .speaking-index__grid {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  @media (min-width: 900px) {
    .speaking-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
