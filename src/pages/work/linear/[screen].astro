---
import PresentationLayout from '../../../layouts/PresentationLayout.astro';
import { linearScreens } from '../../../data/linearDeck';

export function getStaticPaths() {
  return linearScreens().map((screen) => ({
    params: { screen: String(screen.n) },
    props: { screen },
  }));
}

const { screen } = Astro.props;
const screens = linearScreens();
const current = screen ?? screens[0];
if (!current) throw new Error('Missing Linear screen');
const firstN = screens[0].n;
const lastN = screens[screens.length - 1].n;
const position = screens.findIndex((item) => item.n === current.n) + 1;

const clientScreens = screens.map((item) => ({
  n: item.n,
  kind: item.kind,
  title: item.title,
  transcript: item.transcript,
  image: item.image,
}));
---

<PresentationLayout
  title={`${current.title} · Linear Ad Platform`}
  description="A visual introduction to the Linear Ad Platform team Frances Sun led."
>
  <div class="deck" data-linear-deck data-screen={current.n} data-kind={current.kind}>
    <div class="deck__stage" data-stage>
      <div class="deck__column">
        <div class="deck__toolbar">
          <a class="deck__return" href="/#work" data-return aria-label="Back to Selected Work">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M10.25 3.25 5.5 8l4.75 4.75"
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>Selected Work</span>
          </a>
        </div>
        <div class="deck__frame" data-frame>
        <section class="panel panel--upfront" data-panel="upfront" hidden={current.kind !== 'upfront'}>
          <img
            class="upfront__still"
            src="/slides/linear/hi/slide-05.webp"
            alt="In 2023, companies committed $9 billion during Upfront week to Disney."
            width="3598"
            height="2026"
          />
          <img
            class="upfront__base"
            src="/slides/linear/hi/slide-05-base.webp"
            alt=""
            width="3598"
            height="2026"
          />
          <div class="upfront__rain" aria-hidden="true">
            <span class="bill" style="--x:45.6cqw;--w:2.5cqw;--dur:6.4s;--delay:-0.2s;--drift:0.6cqw;--a0:-6deg;--a1:8deg"><img src="/slides/linear/money/bill-01.png" alt="" /></span>
            <span class="bill" style="--x:49.2cqw;--w:1.5cqw;--dur:7.1s;--delay:-1.4s;--drift:-0.8cqw;--a0:4deg;--a1:-7deg"><img src="/slides/linear/money/bill-02.png" alt="" /></span>
            <span class="bill" style="--x:50.3cqw;--w:2.72cqw;--dur:6.6s;--delay:-3.1s;--drift:0.4cqw;--a0:-3deg;--a1:5deg"><img src="/slides/linear/money/bill-03.png" alt="" /></span>
            <span class="bill" style="--x:43.8cqw;--w:2.33cqw;--dur:7.8s;--delay:-5.6s;--drift:-0.5cqw;--a0:7deg;--a1:-4deg"><img src="/slides/linear/money/bill-04.png" alt="" /></span>
            <span class="bill" style="--x:54.3cqw;--w:1.83cqw;--dur:6.9s;--delay:-2.2s;--drift:0.9cqw;--a0:-8deg;--a1:3deg"><img src="/slides/linear/money/bill-05.png" alt="" /></span>
            <span class="bill" style="--x:46cqw;--w:4.92cqw;--dur:8s;--delay:-4.4s;--drift:-0.3cqw;--a0:2deg;--a1:-6deg"><img src="/slides/linear/money/bill-06.png" alt="" /></span>
            <span class="bill" style="--x:51.1cqw;--w:2.36cqw;--dur:6.5s;--delay:-6.1s;--drift:0.7cqw;--a0:-5deg;--a1:9deg"><img src="/slides/linear/money/bill-07.png" alt="" /></span>
            <span class="bill" style="--x:52.3cqw;--w:4.7cqw;--dur:7.4s;--delay:-0.8s;--drift:-1cqw;--a0:6deg;--a1:-2deg"><img src="/slides/linear/money/bill-08.png" alt="" /></span>
            <span class="bill" style="--x:44cqw;--w:5.42cqw;--dur:7.6s;--delay:-3.7s;--drift:0.5cqw;--a0:-2deg;--a1:4deg"><img src="/slides/linear/money/bill-09.png" alt="" /></span>
            <span class="bill" style="--x:51.7cqw;--w:2.58cqw;--dur:6.8s;--delay:-5s;--drift:-0.6cqw;--a0:5deg;--a1:-8deg"><img src="/slides/linear/money/bill-10.png" alt="" /></span>
            <span class="bill" style="--x:49cqw;--w:2.11cqw;--dur:7.9s;--delay:-1.9s;--drift:0.3cqw;--a0:-7deg;--a1:2deg"><img src="/slides/linear/money/bill-11.png" alt="" /></span>
            <span class="bill" style="--x:55.6cqw;--w:2.28cqw;--dur:6.7s;--delay:-4.8s;--drift:-0.4cqw;--a0:3deg;--a1:-5deg"><img src="/slides/linear/money/bill-12.png" alt="" /></span>
            <span class="bill" style="--x:47.1cqw;--w:1.58cqw;--dur:8.1s;--delay:-2.7s;--drift:0.8cqw;--a0:-4deg;--a1:6deg"><img src="/slides/linear/money/bill-13.png" alt="" /></span>
            <span class="bill" style="--x:54.4cqw;--w:1.81cqw;--dur:7.2s;--delay:-6.6s;--drift:-0.7cqw;--a0:8deg;--a1:-3deg"><img src="/slides/linear/money/bill-14.png" alt="" /></span>
            <span class="bill" style="--x:46.1cqw;--w:1.5cqw;--dur:6.3s;--delay:-3.5s;--drift:0.2cqw;--a0:-6deg;--a1:7deg"><img src="/slides/linear/money/bill-15.png" alt="" /></span>
          </div>
        </section>
        <section class="panel panel--image" data-panel="image" hidden={current.kind !== 'image'}>
          <img
            data-shot
            src={current.kind === 'image' ? current.image : undefined}
            alt={current.kind === 'image' ? current.transcript : ''}
            width="3840"
            height="2160"
          />
        </section>

        <section class="panel panel--summary" data-panel="narrative" hidden={current.kind !== 'narrative'}>
          <div class="lsum">
            <header class="lsum__header">
              <h1 class="lsum__title">A shared view of our team’s work</h1>
              <p class="lsum__subtitle">I regularly use this story in team presentations to explain how our products and workflows connect.</p>
            </header>
            <ol class="lsum__points">
              <li>
                <p class="lsum__num">01</p>
                <h2>Team scope</h2>
                <p>Make each product’s role in the advertising workflow clear.</p>
              </li>
              <li>
                <p class="lsum__num">02</p>
                <h2>Connections</h2>
                <p>Show how work moves between products and teams.</p>
              </li>
              <li>
                <p class="lsum__num">03</p>
                <h2>Common language</h2>
                <p>Use a familiar metaphor to explain a complex platform.</p>
              </li>
            </ol>
          </div>
        </section>

        <section class="panel panel--thanks" data-panel="thanks" hidden={current.kind !== 'thanks'}>
          <div class="cov">
            <h1 class="cov__title">Thank you</h1>
            <p class="cov__presenter">Frances Sun</p>
            <p class="cov__role">Lead Designer · Enterprise UX</p>
            <p class="cov__contacts">
              <a href="https://francessun.design/" target="_blank" rel="noopener noreferrer">francessun.design</a>
              <a href="mailto:francessun@gmail.com">francessun@gmail.com</a>
              <a href="https://www.linkedin.com/in/sun0610/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </p>
          </div>
        </section>
      </div>
      <div class="deck__bar" data-bar>
        <button type="button" data-prev disabled={current.n <= firstN}>Previous</button>
        <p data-progress>
          {String(position).padStart(2, '0')} / {String(screens.length).padStart(2, '0')}
        </p>
        <button type="button" data-next disabled={current.n >= lastN}>Next</button>
        <button type="button" data-fullscreen aria-pressed="false">Full screen</button>
      </div>
      </div>
    </div>

    <p class="visually-hidden" aria-live="polite" data-live></p>
  </div>

  <script id="linear-deck-data" type="application/json" set:html={JSON.stringify(clientScreens)} />
  <script>
    import '../../../scripts/linearDeck.ts';
  </script>
</PresentationLayout>

<style>
  .deck {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: 1fr;
    background: #0b0d12;
    color: var(--text);
  }

  .deck__stage {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0.35rem 1.25rem 0.35rem;
  }

  .deck__column {
    width: min(100%, calc((100dvh - 8.75rem) * 16 / 9));
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .deck__toolbar {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .deck__return {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin: 0;
    padding: 0 0.15rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
  }

  .deck__return svg {
    flex: none;
    transition: transform 160ms ease;
  }

  .deck__return:hover {
    color: var(--text);
    text-decoration: none;
  }

  .deck__return:hover svg {
    transform: translateX(-2px);
  }

  .deck__frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: calc(100dvh - 8.75rem);
    background: #070b16;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
  }

  /* These two endings are the rounded 1920×1080 panels. 40px on that
     stage is 2.083% of the width and 3.704% of the height. */
  .deck[data-kind='narrative'] .deck__frame,
  .deck[data-kind='thanks'] .deck__frame {
    background: #020024;
    border-radius: 2.0833% / 3.7037%;
  }

  .deck__frame[data-moving='true'] {
    opacity: 0.72;
  }

  .panel {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .panel[hidden] {
    display: none;
  }

  .panel--image img,
  .upfront__still,
  .upfront__base {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #070b16;
  }

  .upfront__still,
  .upfront__base {
    position: absolute;
    inset: 0;
  }

  .upfront__base,
  .upfront__rain {
    display: none;
  }

  .upfront__rain {
    position: absolute;
    inset: 0;
    container-type: size;
    pointer-events: none;
    overflow: hidden;
  }

  .bill {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--w);
    transform-origin: center;
  }

  .bill img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .upfront__still {
      display: none;
    }

    .upfront__base,
    .upfront__rain {
      display: block;
    }

    .bill {
      animation: upfront-fall var(--dur) linear infinite;
      animation-delay: var(--delay);
    }
  }

  @keyframes upfront-fall {
    0% {
      opacity: 0;
      transform: translate3d(var(--x), 8cqh, 0) rotate(var(--a0));
    }
    12% {
      opacity: 1;
    }
    86% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(calc(var(--x) + var(--drift)), 58cqh, 0) rotate(var(--a1));
    }
  }

  /* Shared understanding. Positions are the interview slide’s 1920×1080
     coordinates, scaled to this frame. */
  .panel--summary,
  .panel--thanks {
    container-type: size;
    color: #fff;
  }

  .panel--summary {
    background: #020024;
  }

  .panel--thanks {
    background: url('/slides/linear/cover-background.svg') 0 0 / 100% 100% no-repeat;
  }

  .lsum,
  .cov {
    position: absolute;
    inset: 0;
    overflow: hidden;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .lsum__header {
    position: absolute;
    left: 3.28125cqw;
    top: 8.148148cqh;
    width: 93.4375cqw;
    display: flex;
    flex-direction: column;
    gap: 0.740741cqh;
  }

  .lsum__title,
  .lsum__subtitle,
  .lsum__num,
  .lsum__points h2,
  .lsum__points p,
  .cov__title,
  .cov__presenter,
  .cov__role,
  .cov__contacts {
    letter-spacing: 0;
    text-wrap: wrap;
  }

  .lsum__title {
    margin: 0;
    width: 100%;
    max-width: none;
    font-size: 2.916667cqw;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    color: #fff;
  }

  .lsum__subtitle {
    margin: 0;
    width: 100%;
    font-size: 1.875cqw;
    font-weight: 500;
    line-height: 1.3333;
    white-space: nowrap;
    color: #d2d2d7;
  }

  .lsum__points {
    position: absolute;
    left: 3.28125cqw;
    top: 39.259259cqh;
    width: 93.4375cqw;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 4.166667cqw;
    align-items: start;
  }

  .lsum__points li {
    margin: 0;
    padding: 2.592593cqh 0 0;
    border-top: 1px solid #6cb8ff;
    min-width: 0;
  }

  .lsum__num {
    margin: 0;
    font-weight: 500;
    font-size: 1.110938cqw;
    line-height: 1.2;
    letter-spacing: 0.08em;
    color: #6cb8ff;
  }

  .lsum__points h2 {
    margin: 2.592593cqh 0 0;
    font-weight: 500;
    font-size: 1.875cqw;
    line-height: 1.15;
    color: #fff;
  }

  .lsum__points li > p:not(.lsum__num) {
    margin: 1.481481cqh 0 0;
    max-width: 23.958333cqw;
    font-weight: 400;
    font-size: 1.354167cqw;
    line-height: 1.35;
    color: #b8bcc7;
  }

  .cov__title,
  .cov__presenter,
  .cov__role {
    position: absolute;
    left: 8.333333cqw;
    display: flex;
    align-items: center;
    margin: 0;
    color: #fff;
    font-weight: 900;
    line-height: 1.2;
    white-space: nowrap;
  }

  .cov__title {
    top: 47.962963cqh;
    width: 92.708333cqw;
    height: 13.518519cqh;
    max-width: none;
    font-size: 5cqw;
  }

  .cov__presenter {
    top: 61.481481cqh;
    width: 37.5cqw;
    height: 5.37037cqh;
    font-size: 2.5cqw;
  }

  .cov__role {
    top: 66.851852cqh;
    width: 46.875cqw;
    height: 7.037037cqh;
    font-size: 1.875cqw;
    opacity: 0.3;
  }

  .cov__contacts {
    position: absolute;
    left: 8.333333cqw;
    top: 78.333333cqh;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 2.916667cqw;
    row-gap: 1.111111cqh;
    width: 78.125cqw;
    margin: 0;
    font-size: 1.666667cqw;
    font-weight: 400;
    line-height: 1.375;
  }

  .cov__contacts a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    cursor: pointer;
  }

  .cov__contacts a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.3125cqw;
  }

  .cov__contacts a:focus-visible {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.3125cqw;
    outline: 2px solid #fff;
    outline-offset: 0.3125cqw;
    border-radius: 4px;
  }

  .deck__bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.7rem 0 calc(0.35rem + env(safe-area-inset-bottom));
  }

  .deck__bar button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    border: 1px solid rgba(242, 239, 233, 0.14);
    background: transparent;
    color: var(--text);
    border-radius: 999px;
    padding: 0 0.95rem;
    font: inherit;
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
  }

  .deck__bar button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .deck__bar button:focus-visible,
  .deck__return:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .deck__bar p {
    margin: 0 0.35rem;
    min-width: 4.5rem;
    text-align: center;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .deck[data-idle='true'] .deck__bar,
  .deck[data-idle='true'] .deck__toolbar {
    opacity: 0;
  }

  .deck[data-idle='true'] .deck__bar:focus-within,
  .deck[data-idle='true'] .deck__toolbar:focus-within {
    opacity: 1;
  }

  @media (max-width: 800px) {
    .deck__stage {
      padding-inline: 0.85rem;
      min-width: 0;
    }

    .deck__bar {
      gap: 0.4rem;
    }

    .deck__frame {
      width: 100%;
      aspect-ratio: auto;
      max-height: calc(100dvh - 8.5rem);
      height: auto;
      overflow: auto;
    }

    .panel {
      position: relative;
      inset: auto;
    }

    .panel[hidden] {
      display: none;
    }

    .deck[data-kind='narrative'] .deck__frame,
    .deck[data-kind='thanks'] .deck__frame {
      max-height: none;
      overflow: hidden;
      border-radius: 16px;
    }

    .panel--summary,
    .panel--thanks {
      container-type: normal;
    }

    .lsum,
    .cov {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1.15rem 1.4rem;
      gap: 1.35rem;
    }

    .cov {
      min-height: min(72dvh, 36rem);
      justify-content: flex-end;
      padding-top: 4.5rem;
      gap: 0.2rem;
      background: url('/slides/linear/cover-background.svg') 0 0 / 100% 100% no-repeat;
    }

    .lsum__header,
    .lsum__points,
    .cov__title,
    .cov__presenter,
    .cov__role,
    .cov__contacts {
      position: static;
      left: auto;
      top: auto;
      width: auto;
      height: auto;
    }

    .lsum__title,
    .lsum__subtitle,
    .cov__title,
    .cov__presenter,
    .cov__role {
      white-space: normal;
    }

    .lsum__title {
      font-size: 1.65rem;
      line-height: 1.12;
    }

    .lsum__subtitle {
      margin-top: 0.45rem;
      font-size: 1rem;
      line-height: 1.4;
    }

    .lsum__points {
      grid-template-columns: 1fr;
      row-gap: 1.15rem;
    }

    .lsum__points li {
      padding-top: 0.85rem;
    }

    .lsum__num {
      font-size: 0.8rem;
    }

    .lsum__points h2 {
      margin-top: 0.55rem;
      font-size: 1.15rem;
    }

    .lsum__points li > p:not(.lsum__num) {
      max-width: 36rem;
      margin-top: 0.4rem;
      font-size: 0.98rem;
    }

    .cov__title {
      font-size: 2.5rem;
    }

    .cov__presenter {
      margin-top: 0.35rem;
      font-size: 1.35rem;
    }

    .cov__role {
      font-size: 1.05rem;
    }

    .cov__contacts {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      margin-top: 1.1rem;
      font-size: 1rem;
    }

    .cov__contacts a:hover,
    .cov__contacts a:focus-visible {
      text-underline-offset: 0.22em;
    }

    .cov__contacts a:focus-visible {
      outline-offset: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck__frame {
      transition: none;
    }

    .deck__bar,
    .deck__toolbar,
    .deck__return svg {
      transition: none;
    }
  }
</style>